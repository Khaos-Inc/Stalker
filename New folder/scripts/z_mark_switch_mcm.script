-- Compatibility settings provider. The UI is registered by z_3d_scopes_mcm.
local defaults = {
	["keybind"] = DIK_keys.DIK_EQUALS,
	["keybind_reverse"] = DIK_keys.DIK_MINUS,
	["modifier"] = 0,
	["modifier_reverse"] = 0,
	["press_type"] = 0,
	["press_type_reverse"] = 0,
}

function get_config(key)
	if not ui_mcm then
		return defaults[key]
	end

	local value = ui_mcm.get("3d_scopes/mark_switch/" .. key)
	if value == nil then
		value = ui_mcm.get("mark_switch/" .. key)
	end
	if value == nil then
		value = defaults[key]
	end
	return value
end
