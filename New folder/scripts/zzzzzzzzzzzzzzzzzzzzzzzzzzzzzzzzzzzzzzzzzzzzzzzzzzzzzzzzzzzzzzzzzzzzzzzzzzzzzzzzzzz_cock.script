-- this script was generated by Sickhowl bot
-- for Melancholy Weathers
-- long live indian scam call centers....
-- note to pipnik: if you feel too stupid lower this value
local DEBOUNCE_MS = 128
local MAX_FOG_DISTANCE = 1500

local weather_set_value_numeric = weather.set_value_numric
local weather_get_value_numeric = weather.get_value_numric
local grok_last_update_time = 0

---@param multiplier number
function level_fog_apply_multiplier(multiplier)
    -- curry delivery
    return function()
        local now = time_global()

        if now - grok_last_update_time < DEBOUNCE_MS then
            return
        end

        local current_fog_distance = weather_get_value_numeric("fog_distance")
        assert(current_fog_distance, "Failed to get current fog_distance")

        local new_fog_distance = clamp(current_fog_distance * multiplier, 0, MAX_FOG_DISTANCE)

        weather_set_value_numeric("fog_distance", new_fog_distance)
    end
end

function level_fog_register()
    local level_name = level.name()
    assert(level_name, "Missing level name")

    local config = ini_file([[scripts\fog_multipliers.ltx]])
    assert(
        config:section_exist("fog_multipliers"),
        "Add the fog_multipliers section to the damned LTX Pipnik you doofus"
    )

    local multiplier = config:r_float_ex("fog_multipliers", level_name)

    if not multiplier then
        printf("Found no multiplier for level %s", level_name)
        return
    end

    -- hi ProfLander are you proud of me :sob:
    RegisterScriptCallback("actor_on_update", level_fog_apply_multiplier(multiplier))
end

function on_game_start()
    RegisterScriptCallback("actor_on_first_update", level_fog_register)
end
