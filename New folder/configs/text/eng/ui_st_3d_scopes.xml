<?xml version="1.0" encoding="windows-1251"?>
<string_table>

	<string id="ui_mcm_menu_3d_scopes">
		<text>3D Scopes</text>
	</string>
	
	<string id="ui_mcm_3d_scopes_title">
		<text>3D Shader Scopes for GAMMA</text>
	</string>
	
	
	<string id="ui_mcm_menu_3d_scopes_scope_settings">
		<text>Scope Settings</text>
	</string>
	<string id="ui_mcm_3d_scopes_scope_settings_zoom_factor">
		<text>Zoom factor</text>
	</string>
	<string id="ui_mcm_3d_scopes_scope_settings_zoom_factor_desc">
		<text>Adds some camera zoom on top of the base zoom of the scope to simulate a lensing effect. Higher values cause drop in scope resolution. 1.3 is a good number.</text>
	</string>
	<string id="ui_mcm_3d_scopes_scope_settings_nvg_blur">
		<text>Blur scope in Beefs NVG</text>
	</string>
	<string id="ui_mcm_3d_scopes_scope_settings_parallax_shadow">
		<text>Render parallax shadow</text>
	</string>
	<string id="ui_mcm_3d_scopes_scope_settings_see_through">
		<text>Reticle and exit pupil are always visible</text>
	</string>
	<string id="ui_mcm_3d_scopes_scope_settings_thermal_pixelation">
		<text>Pixelate thermal scopes when using zoom</text>
	</string>
	<string id="ui_mcm_3d_scopes_scope_settings_chromatism">
		<text>Scopes have chromatism</text>
	</string>
	<string id="ui_mcm_3d_scopes_scope_settings_nvg_force_alt">
		<text>NVG canted aim with scopes</text>
	</string>
	<string id="ui_mcm_3d_scopes_scope_settings_nvg_force_alt_desc">
		<text>Certain scopes are too big to be used with NVGs and are forced into a canted aim mode when this option is on. Scopes that are compatible will be listed in their descriptions.</text>
	</string>
	<string id="ui_mcm_3d_scopes_scope_settings_canted_sight_editors">
		<text>Enable canted sight adjustment UIs</text>
	</string>
	<string id="ui_mcm_3d_scopes_scope_settings_canted_sight_editors_desc">
		<text>Allows the canted sight aim and visual position adjustment interfaces to be opened.</text>
	</string>
	<string id="ui_mcm_3d_scopes_scope_settings_shader_switcher">
		<text>Simulated two-eye aiming</text>
	</string>
	<string id="ui_mcm_3d_scopes_scope_settings_shader_switcher_desc">
		<text>Master switch for simulated two-eye aiming. Toggle off to disable transparent effect on all sights/scopes/irons.</text>
	</string>	
	<string id="ui_mcm_3d_scopes_scope_settings_shader_switcher_scopes">
		<text>Switch scope housings</text>
	</string>
	<string id="ui_mcm_3d_scopes_scope_settings_shader_switcher_scopes_desc">
		<text>Applies simulated two-eye aiming to scopes. This option has no effect when simulated two-eye aiming is disabled.</text>
	</string>
	<string id="ui_mcm_3d_scopes_scope_settings_shader_switcher_sights">
		<text>Switch red dot housings</text>
	</string>
	<string id="ui_mcm_3d_scopes_scope_settings_shader_switcher_sights_desc">
		<text>Applies simulated two-eye aiming to sights. This option has no effect when simulated two-eye aiming is disabled.</text>
	</string>	
	<string id="ui_mcm_3d_scopes_scope_settings_shader_switcher_rear_irons">
		<text>Include rear iron sights</text>
	</string>
	<string id="ui_mcm_3d_scopes_scope_settings_shader_switcher_rear_irons_desc">
		<text>Applies simulated two-eye aiming to iron sights. This option has no effect when simulated two-eye aimingg is disabled.</text>
	</string>
	<string id="ui_mcm_3d_scopes_scope_settings_shader_switcher_opacity">
		<text>ADS housing opacity</text>
	</string>
	<string id="ui_mcm_3d_scopes_scope_settings_shader_switcher_opacity_desc">
		<text>Sets the opacity of affected weapon meshes. 1 is more transparent and a less blurry housing, 10 is less transparent and a more blurry housing.</text>
	</string>


	<string id="ui_mcm_3d_scopes_magnifier_switch_tab">
		<text>Magnifier Switch</text>
	</string>
	<string id="ui_mcm_3d_scopes_magnifier_switch_use_mousewheel">
		<text>Use Mousewheel</text>
	</string>
	<string id="ui_mcm_3d_scopes_magnifier_switch_use_mousewheel_desc">
		<text>Uses mousewheel input for magnifier switching and disables the keybind settings below.</text>
	</string>
	<string id="ui_mcm_3d_scopes_magnifier_switch_mwheel_switch_ads_only">
		<text>Mousewheel Switch On ADS Only</text>
	</string>
	<string id="ui_mcm_3d_scopes_magnifier_switch_mwheel_switch_ads_only_desc">
		<text>Disables magnifier switching with the mousewheel while not aiming.</text>
	</string>
	<string id="ui_mcm_3d_scopes_magnifier_switch_mwheel_weapon_swap">
		<text>Enable Mousewheel Weapon Swap</text>
	</string>
	<string id="ui_mcm_3d_scopes_magnifier_switch_mwheel_weapon_swap_desc">
		<text>Controls the mouse_wheel_change_weapon console setting.</text>
	</string>
	<string id="ui_mcm_3d_scopes_magnifier_switch_switch_bind">
		<text>Magnifier Switch Keybind</text>
	</string>
	<string id="ui_mcm_3d_scopes_magnifier_switch_switch_bind_desc">
		<text>When assigned to the Sight Aim Mode Toggle key, normal key behavior remains available when the magnifier cannot switch or the configured modifier and input mode are not performed.</text>
	</string>
	<string id="ui_mcm_3d_scopes_magnifier_switch_modifier">
		<text>Magnifier switch modifier</text>
	</string>
	<string id="ui_mcm_3d_scopes_magnifier_switch_press_type">
		<text>Magnifier switch input mode</text>
	</string>
	<string id="ui_mcm_3d_scopes_magnifier_switch_keep_aim_toggle">
		<text>Maintain ADS Toggle</text>
	</string>
	<string id="ui_mcm_3d_scopes_magnifier_switch_keep_aim_toggle_desc">
		<text>Maintains ADS while switching the magnifier when ADS toggle mode is used.</text>
	</string>
	<string id="ui_mcm_3d_scopes_magnifier_switch_switch_sound">
		<text>Play Sound Effect</text>
	</string>
	<string id="ui_mcm_3d_scopes_magnifier_switch_switch_sound_desc">
		<text>Plays a sound effect when the magnifier mode changes.</text>
	</string>
	<string id="ui_mcm_3d_scopes_magnifier_switch_debug">
		<text>Debug logging</text>
	</string>


