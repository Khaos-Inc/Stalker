-- Enemy Debug Tool



local danger_types = {
	[danger_object and danger_object.grenade or 0] = "grenade",
	[danger_object and danger_object.entity_corpse or 1] = "entity_corpse",
	[danger_object and danger_object.entity_attacked or 2] = "entity_attacked",
	[danger_object and danger_object.attacked or 3] = "attacked",
	[danger_object and danger_object.bullet_ricochet or 4] = "bullet_ricochet",
	[danger_object and danger_object.enemy_sound or 5] = "enemy_sound",
	[danger_object and danger_object.attack_sound or 6] = "attack_sound",
	[danger_object and danger_object.entity_death or 7] = "entity_death",
	[danger_object and danger_object.hit or 8] = "hit",
	[danger_object and danger_object.sound or 9] = "sound",
	[danger_object and danger_object.visual or 10] = "visual"
}

function render()
	local near = xrs_debug_tools.get_debug_npc and xrs_debug_tools.get_debug_npc()
	local near_name = near and near:name() or "No NPC"
	local near_id = near and near:id() or "N/A"
	
	ImGui.Text("Debug NPC: " .. near_name .. " (ID: " .. tostring(near_id) .. ")")
	ImGui.Separator()
	
	-- Always display basic information
	local has_npc = near and near:alive()
	local se_obj = has_npc and alife_object and alife_object(near:id())
	local st = has_npc and db and db.storage and db.storage[near:id()]
	
	-- NPC Basic Information
	ImGui.Text("NPC Basic Information:")
	ImGui.Text("Name: " .. near_name)
	
	-- Actor Relation
	local relation_text = "N/A"
	if (has_npc and db and db.actor) then
		local relation = { 
			[game_object and game_object.enemy or 0] = "enemy",
			[game_object and game_object.friend or 1] = "friend",
			[game_object and game_object.neutral or 2] = "neutral"
		}
		local rel_id = near:relation(db.actor)
		relation_text = relation[rel_id] or "unknown"
	end
	ImGui.Text("Actor Relation: " .. relation_text)
	
	-- Script Combat Type
	local script_combat = st and st.script_combat_type or "None"
	ImGui.Text("Script Combat: " .. tostring(script_combat))
	
	ImGui.Separator()
	
	-- Enemy Information
	ImGui.Text("Enemy Information:")
	local be = has_npc and near:best_enemy()
	
	local best_enemy_name = be and be:name() or "None"
	ImGui.Text("Best Enemy: " .. best_enemy_name)
	
	local can_see = (has_npc and be) and tostring(near:see(be)) or "N/A"
	ImGui.Text("Can See Best Enemy: " .. can_see)
	
	-- Pure Enemy
	local ene = st and st.enemy_id and level and level.object_by_id and level.object_by_id(st.enemy_id)
	local pure_enemy_name = ene and ene:name() or "None"
	ImGui.Text("Pure Enemy: " .. pure_enemy_name)
	
	-- Combat Ignore Condition
	local combat_ignore_cond = "None"
	if (ene and st and st.overrides and st.overrides.combat_ignore and xr_logic and xr_logic.pick_section_from_condlist) then
		combat_ignore_cond = xr_logic.pick_section_from_condlist(ene, near, st.overrides.combat_ignore.condlist) or "None"
	end
	ImGui.Text("Combat Ignore Condition: " .. tostring(combat_ignore_cond))
	
	ImGui.Separator()
	
	-- Timing Information
	ImGui.Text("Timing Information:")
	local tg = time_global and time_global() or 0
	
	-- Post Combat Wait
	local pcw = st and st.post_combat_wait and st.post_combat_wait.timer and 
		st.post_combat_wait.timer > 0 and st.post_combat_wait.timer - tg
	local pcw_text = (pcw and pcw > 0) and tostring(pcw) or "None"
	ImGui.Text("Post Combat Idle: " .. pcw_text)
	
	-- Memory Time
	local memory_time = (be and has_npc) and tostring(tg - near:memory_time(be)) or "N/A"
	ImGui.Text("Memory Time: " .. memory_time)
	
	-- Search Time
	local search_time = (st and st.combat_ignore and st.combat_ignore.search_time) and 
		tostring(st.combat_ignore.search_time) or "N/A"
	ImGui.Text("Search Time: " .. search_time)
	
	-- Safe Zone Timer
	local safe_zone_text = "No"
	if (has_npc and xr_combat_ignore and xr_combat_ignore.safe_zone_npcs) then
		local squad = get_object_squad and get_object_squad(near)
		local cid = squad and squad.id or near:id()
		if (xr_combat_ignore.safe_zone_npcs[cid]) then
			local timer = xr_combat_ignore.safe_zone_npcs[cid] - tg
			safe_zone_text = tostring(timer)
		end
	end
	ImGui.Text("In No-Combat Zone: " .. safe_zone_text)
	
	ImGui.Separator()
	
	-- Danger Information
	local bd = has_npc and near:best_danger()
	local danger_info = {}
	local danger_mode_info = {}
	local used_lvids = {}
	
	if (bd) then		
		local bdname = bd:object() and bd:object():name()
		local bddname = bd:dependent_object() and bd:dependent_object():name()
		local bd_type = bd:type()
		
		table.insert(danger_info, {"Type", danger_types[bd_type] or "unknown"})
		table.insert(danger_info, {"Danger Object", bdname or "None"})
		table.insert(danger_info, {"Dependent", bddname or "None"})
		
		if (xr_danger and xr_danger.has_danger and xr_danger.has_danger(near)) then
			if (st and st.danger) then
				local danger_bd_type = st.danger.type
				table.insert(danger_mode_info, {"Type", danger_bd_type and danger_types[danger_bd_type] or "None"})
				local danger_time = st.danger.danger_time
				local inertion = st.danger.inertion
				local timr = inertion and danger_time and (danger_time + inertion) - tg
				table.insert(danger_mode_info, {"Timer", timr and timr > 0 and tostring(timr) or "0"})
			end
		end
		
		-- Collect used level vertex IDs
		if (db and db.used_level_vertex_ids) then
			for k, v in pairs(db.used_level_vertex_ids) do
				table.insert(used_lvids, {tostring(k), tostring(v)})
			end
		end
	end
	
	-- Best Danger Information
	ImGui.Text("Best Danger (Pre-Evaluation):")
	
	local danger_type = "N/A"
	local danger_object_name = "N/A"
	local dependent_name = "N/A"
	
	if (bd) then
		local bdname = bd:object() and bd:object():name()
		local bddname = bd:dependent_object() and bd:dependent_object():name()
		local bd_type = bd:type()
		
		danger_type = danger_types[bd_type] or "unknown"
		danger_object_name = bdname or "None"
		dependent_name = bddname or "None"
	end
	
	ImGui.Text("Type: " .. danger_type)
	ImGui.Text("Danger Object: " .. danger_object_name)
	ImGui.Text("Dependent: " .. dependent_name)
	
	-- Danger Mode Information
	ImGui.Separator()
	ImGui.Text("Danger Mode (Active):")
	
	local danger_mode_type = "N/A"
	local danger_mode_timer = "N/A"
	
	if (bd and xr_danger and xr_danger.has_danger and xr_danger.has_danger(near)) then
		if (st and st.danger) then			
			local danger_bd_type = st.danger.type
			danger_mode_type = danger_bd_type and danger_types[danger_bd_type] or "None"
			local danger_time = st.danger.danger_time
			local inertion = st.danger.inertion
			local timr = inertion and danger_time and (danger_time + inertion) - tg
			danger_mode_timer = timr and timr > 0 and tostring(timr) or "0"
		end
	end
	
	ImGui.Text("Type: " .. danger_mode_type)
	ImGui.Text("Timer: " .. danger_mode_timer)
	
	-- Used Level Vertex IDs
	ImGui.Separator()
	ImGui.Text("Used Level Vertex IDs:")
	
	if ImGui.BeginTable("UsedVertexIDs", 2, 3, vector2(0, 0), 0) then
		ImGui.TableSetupColumn("Vertex ID")
		ImGui.TableSetupColumn("NPC ID")
		ImGui.TableHeadersRow()
		
		for vertex_id, npc_id in pairs(db.used_level_vertex_ids) do
			ImGui.TableNextRow()
			ImGui.TableSetColumnIndex(0)
			ImGui.Text(tostring(vertex_id))
			ImGui.TableSetColumnIndex(1)
			ImGui.Text(tostring(npc_id))
		end
		
		ImGui.EndTable()
	end
	
	ImGui.Separator()
	
	-- Current Item at Cell
	ImGui.Text("Current Item at Cell: " .. tostring(CurrentItemAtCell and CurrentItemAtCell() or "N/A"))
end

-- Tool registration
imgui_debug_tools.register_tool("enemy_hud", {
	title = "Enemy Info",
	render = render,
	visible = false
})
