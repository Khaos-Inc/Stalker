-- Arena Debug Tool



function render()
	-- Always display arena zone information
	local arena_zones = {}
	
	-- Collect arena zones
	if db and db.zone_by_name then
		for name, zone in pairs(db.zone_by_name) do
			if (string.find(name, "arena")) then
				local st = db.storage and db.storage[zone:id()]
				if (st and st.active_section and st.active_section ~= "nil") then
					local ini_filename = st.ini_filename ~= "<custom_data>" and st.ini_filename or ""
					table.insert(arena_zones, {
						name = zone:name(),
						ini = ini_filename,
						active_section = st.active_section
					})
				end
			end
		end
	end
	
	ImGui.Text("Arena Zones Information:")
	if ImGui.BeginTable("ArenaZones", 3, 3, vector2(0, 0), 0) then
		ImGui.TableSetupColumn("Zone Name")
		ImGui.TableSetupColumn("INI File")
		ImGui.TableSetupColumn("Active Section")
		ImGui.TableHeadersRow()
		
		for _, zone_info in ipairs(arena_zones) do
			ImGui.TableNextRow()
			ImGui.TableSetColumnIndex(0)
			ImGui.Text(zone_info.name)
			ImGui.TableSetColumnIndex(1)
			ImGui.Text(zone_info.ini)
			ImGui.TableSetColumnIndex(2)
			ImGui.Text(zone_info.active_section)
		end
	
		ImGui.EndTable()
	end
	
	ImGui.Separator()
	
	-- Summary Information
	ImGui.Text("Summary:")
	ImGui.Text("Total Arena Zones: " .. tostring(#arena_zones))
	ImGui.Text("Zone Database Available: " .. tostring(db and db.zone_by_name ~= nil))
end

-- Tool registration
imgui_debug_tools.register_tool("arena_hud", {
	title = "Arena Debugger",
	render = render,
	visible = false
})
