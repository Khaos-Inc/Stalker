--[[
Built from Stimpestamp's Hover Drop and Disassemble Hotkey mod
https://www.moddb.com/mods/stalker-anomaly/addons/drop-and-disassemble-hotkey
All props for coding go to that mod
I just removed the drop and disassemble and added in the mag unload and eject part

		Khaos Inc

]]
local mcm_keybinds = ui_mcm and ui_mcm.key_hold
local KEY_UNLOAD = DIK_keys.DIK_C

function on_mcm_load()
	return {
		id = "mags_unload_eject",
		sh = true,
		gr = {
			{id = "title", type = "slide", link = "ui_options_slider_player", text = "Unload Eject Mag", size = {512, 50}, spacing = 20},
			{id = "key_unload", type = "key_bind", val = 2, def = KEY_UNLOAD},
		}
	}
end

local function on_option_change(mcm)
	if mcm then
		KEY_UNLOAD = ui_mcm.get("mags_unload_eject/key_unload") or KEY_UNLOAD
	end
end

local function tablelength(T)
	local count = 0
	for _ in pairs(T) do count = count + 1 end
	return count
end

local function if_in_inventory(obj_inp)
	for i = 0, tablelength(_G.SCANNED_SLOTS) + 1, 1 do
		local tmp = db.actor:item_in_slot(i)
		if tmp and obj_inp:id() == tmp:id() then
			return true
		end
	end
	return false
end

local function get_hover()
	local bag = ui_inventory.GUI.hover.bag
	local idx = ui_inventory.GUI.hover.idx
	if idx then
		return ui_inventory.GUI.CC[bag]:GetObj(idx), bag
	end
end

function unloadeject(obj, bag, lootMode, dik)
	if not obj then return end
	local gui = ui_inventory.GUI
	if not gui then return end
	local op = gui.magazine_operation
	if op and op.id == obj:id() and op.unloading == false then
		return
	end
	if obj.is_inventory_magazine and obj:is_inventory_magazine() then
		gui:Action_Unload_Detachable_Mag(obj, bag)
	elseif module_items.find_installed_magazine_index and module_items.find_installed_magazine_index(obj) then
		gui:Action_Unload(obj, bag)
	elseif obj.get_ammo_in_magazine and (obj:get_ammo_in_magazine() or 0) > 0 then
		gui:Action_Unload(obj, bag)
	end
	--gui:RefreshMagazineCell(obj, bag)
	gui:On_Item_Update()
end

function handle_KeyPress(dik, lootMode)
	local obj, bag = get_hover()
	if not obj then
		return
	end
	if dik == KEY_UNLOAD then
		unloadeject(obj, bag, lootMode, dik)
	end
end

local original_OnKeyboard = ui_inventory and ui_inventory.UIInventory and ui_inventory.UIInventory.OnKeyboard
local original_Start_Load_Detachable_Mag = ui_inventory and ui_inventory.UIInventory
	and ui_inventory.UIInventory.Start_Load_Detachable_Mag
local original_Action_Unload_Detachable_Mag = ui_inventory and ui_inventory.UIInventory
	and ui_inventory.UIInventory.Action_Unload_Detachable_Mag
  
_G.mag_hotkey_unload_active = false

function ui_inventory.UIInventory:Start_Load_Detachable_Mag(obj, bag, ammo_obj)
	if not obj then return false end
	local op = self.magazine_operation
	if op and op.id == obj:id() and op.unloading then
		return false
	end
	return original_Start_Load_Detachable_Mag(self, obj, bag, ammo_obj)
end

function ui_inventory.UIInventory:Action_Unload_Detachable_Mag(obj, bag)  
	if _G.mag_hotkey_unload_active then  
		-- your custom guard logic here  
		local check_id = obj and obj.id and obj:id() or nil  
		local op = self.magazine_operation  
		if op and check_id and op.id == check_id and not op.unloading then  
			return  
		end  
	end  
	return original_Action_Unload_Detachable_Mag(self, obj, bag)  
end


local key_unload_was_down = false

function ui_inventory.UIInventory:OnKeyboard(dik, keyboard_action)

	local res = original_OnKeyboard(self, dik, keyboard_action)
	if keyboard_action == ui_events.WINDOW_KEY_PRESSED then
		lootMode = ui_inventory.GUI.mode or nil
		if lootMode == "inventory" or lootMode == "loot" then
			if dik == KEY_UNLOAD then
				if not key_unload_was_down then
					key_unload_was_down = true
					handle_KeyPress(dik, lootMode)
				end
			else
				handle_KeyPress(dik, lootMode)
			end
		end
	elseif keyboard_action == ui_events.WINDOW_KEY_RELEASED and dik == KEY_UNLOAD then
		key_unload_was_down = false
	end
	return res
end
function on_game_start()
	RegisterScriptCallback("on_option_change",on_option_change)
	on_option_change(mcm_keybinds)
end