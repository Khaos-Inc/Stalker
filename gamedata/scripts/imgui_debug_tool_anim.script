-- Animation Debug Tool



function render()
	local near = xrs_debug_tools.get_debug_npc()
	local near_name = near and near:name() or "No NPC"
	local near_id = near and near:id() or "N/A"
	
	ImGui.Text("Debug NPC: " .. near_name .. " (ID: " .. tostring(near_id) .. ")")
	ImGui.Separator()
	
	-- Always display animation information
	local has_npc = near and near:alive()
	local st = has_npc and db and db.storage and db.storage[near:id()]
	local sobj = has_npc and alife_object and alife_object(near:id())
	
	-- Basic Animation Information
	ImGui.Text("Basic Animation Information:")
	local section_name = sobj and sobj:section_name() or "N/A"
	ImGui.Text("Section Name: " .. tostring(section_name))
	local in_cover = has_npc and tostring(near:in_smart_cover()) or "N/A"
	ImGui.Text("In Smart Cover: " .. in_cover)
	local dest_cover = has_npc and near:get_dest_smart_cover_name() or "N/A"
	ImGui.Text("Destination Cover: " .. tostring(dest_cover))
	local use_smart_covers = has_npc and tostring(near:use_smart_covers_only()) or "N/A"
	ImGui.Text("Use Smart Cover Only: " .. use_smart_covers)
	
	ImGui.Separator()
	
	-- Scheme-specific information
	local active_scheme = st and st.active_scheme or "None"
	local all_actions = {}
	local approved_actions = {}
	
	ImGui.Text("Active Scheme: " .. active_scheme)
	-- Animpoint Scheme Information
	if active_scheme == "animpoint" then
		local avail_animations = {}
		
		-- Collect available animations
		if st and st.animpoint and st.animpoint.avail_animations then
			for k, v in pairs(st.animpoint.avail_animations) do
				table.insert(avail_animations, v)
			end
		end
		
		-- Collect actions
		local description = (st and st.animpoint and st.animpoint.description) or "N/A"
		local avail_actions = description ~= "N/A" and xr_animpoint_predicates and 
			xr_animpoint_predicates.associations and xr_animpoint_predicates.associations[description]
		if avail_actions then
			for k, v in pairs(avail_actions) do
				table.insert(all_actions, v.name)
				if (v.predicate and v.predicate(near:id(), st.animpoint.use_camp)) then
					table.insert(approved_actions, v.name)
				end
			end
		end
		
		-- Basic animpoint data
		local cover_name = (st and st.animpoint and st.animpoint.cover_name) or "N/A"
		local use_camp = (st and st.animpoint and st.animpoint.use_camp) or "N/A"
		local smart_dir = (st and st.animpoint and st.animpoint.smart_direction and utils_data and 
			utils_data.vector_to_string and utils_data.vector_to_string(st.animpoint.smart_direction)) or "N/A"
		
		ImGui.Text("Cover Name: " .. tostring(cover_name))
		ImGui.Text("Use Camp: " .. tostring(use_camp))
		ImGui.Text("Description: " .. tostring(description))
		ImGui.Text("Smart Direction: " .. tostring(smart_dir))
		
		-- Available Animations Table
		ImGui.Text("Available Animations:")
		if ImGui.BeginTable("AvailAnimations", 1, 3, vector2(0, 0), 0) then
			ImGui.TableSetupColumn("Animation")
			ImGui.TableHeadersRow()
			
			for _, anim in ipairs(avail_animations) do
				ImGui.TableNextRow()
				ImGui.TableSetColumnIndex(0)
				ImGui.Text(tostring(anim))
			end
			
			ImGui.EndTable()
		end
	-- Walker Scheme Information
	elseif active_scheme == "walker" then		
		-- Collect walker actions
		if st and st.walker and xr_animpoint_predicates and xr_animpoint_predicates.associations then
			local avail_actions = xr_animpoint_predicates.associations["walker_camp"]
			if avail_actions then
				for k, v in pairs(avail_actions) do
					table.insert(all_actions, v.name)
					if (v.predicate and v.predicate(near:id())) then
						table.insert(approved_actions, v.name)
					end
				end
			end
		end
		
		-- Walker data
		local use_camp = (st and st.walker and st.walker.use_camp) or "N/A"
		local state_moving = (st and st.walker and st.walker.suggested_state and st.walker.suggested_state.moving) or "N/A"
		local state_standing = (st and st.walker and st.walker.suggested_state and st.walker.suggested_state.standing) or "N/A"
		
		ImGui.Text("Use Camp: " .. tostring(use_camp))
		ImGui.Text("Default State Moving: " .. tostring(state_moving))
		ImGui.Text("Default State Standing: " .. tostring(state_standing))
	else
		-- No specific scheme information
		ImGui.Text("No scheme-specific animation information available")
	end

	ImGui.Separator()
	ImGui.Text("Available Actions:")
	if ImGui.BeginTable("AvailActions", 1, 3, vector2(0, 0), 0) then
		ImGui.TableSetupColumn("Action")
		ImGui.TableHeadersRow()
		
		for _, action in ipairs(all_actions) do
			ImGui.TableNextRow()
			ImGui.TableSetColumnIndex(0)
			ImGui.Text(tostring(action))
		end
		
		ImGui.EndTable()
	end
	
	ImGui.Separator()
	ImGui.Text("Approved Actions:")
	if ImGui.BeginTable("ApprovedActions", 1, 3, vector2(0, 0), 0) then
		ImGui.TableSetupColumn("Action")
		ImGui.TableHeadersRow()
		
		for _, action in ipairs(approved_actions) do
			ImGui.TableNextRow()
			ImGui.TableSetColumnIndex(0)
			ImGui.Text(tostring(action))
		end
		
		ImGui.EndTable()
	end
end

-- Tool registration
imgui_debug_tools.register_tool("anim_hud", {
	title = "Anim Info",
	render = render,
	visible = false
})
