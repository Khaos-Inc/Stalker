-- Register this tool
imgui_debug_tools.register_tool("StalkerInfoHud", {
    title = "Stalker Info",
    render = function()
        render_stalker_info_hud()
    end,
    visible = false
})

function render_stalker_info_hud()
    local near = xrs_debug_tools.get_debug_npc()
    
    local st = near and near:alive() and db.storage[near:id()]
    if not st then
        ImGui.Text("No NPC selected, not alive, or no storage data")
        return
    end
    
    local sobj = alife_object(near:id())
    if not sobj then
        ImGui.Text("No server object found")
        return
    end
    
    -- Basic info
    ImGui.Text("Name: " .. near:name())
    ImGui.Text("Section: " .. sobj:section_name())
    ImGui.Text("SID: " .. tostring(get_object_story_id(near:id())))
    ImGui.Text("CLSID: " .. tostring(near:clsid()))
    
    ImGui.Text("Parent ID: " .. (sobj.parent_id and sobj.parent_id ~= 65535 and tostring(sobj.parent_id) or "None"))
    ImGui.Text("Squad ID: " .. (sobj.group_id and sobj.group_id ~= 65535 and tostring(sobj.group_id) or "None"))
    
    ImGui.Text("Community: " .. tostring(character_community(near)))
    ImGui.Text("Rank: " .. tostring(ranks.get_obj_rank_name(near)))
    ImGui.Text("Visual: " .. near:get_visual_name())
    ImGui.Text("Health: " .. tostring(math.floor(near.health * 100)))
    ImGui.Text("FOV: " .. tostring(near:fov()))
    ImGui.Text("Range: " .. tostring(near:range()))
    ImGui.Text("rx_dont_shoot: " .. tostring(st.rx_dont_shoot))
    
    local sight_type = near:sight_params()
    ImGui.Text("Sight Type: " .. tostring(sight_type and sight_type.m_sight_type or "nil"))
    
    -- Smart terrain info
    local smrt = sobj.m_smart_terrain_id and sobj.m_smart_terrain_id ~= 65535 and alife_object(sobj.m_smart_terrain_id)
    ImGui.Text("m_smart_terrain_id: " .. (smrt and smrt:name() or "None"))
    
    local arriving = smrt and smrt.arriving_npc and smrt.arriving_npc[sobj.id]
    ImGui.Text("arriving_npc: " .. (arriving and "true" or "false"))
    
    local arrived = smrt and check_arrived_to_smart(sobj, smrt) or false
    ImGui.Text("Arrived: " .. tostring(arrived))
    
    local npc_info = smrt and smrt.npc_info and smrt.npc_info[sobj.id]
    ImGui.Text("npc_info: " .. (npc_info and "Present" or "None"))
    ImGui.Text("Job: " .. (npc_info and npc_info.job and tostring(npc_info.job.section) or "None"))
    
    -- Scheme info
    ImGui.Text("A.Scheme: " .. tostring(st.active_scheme))
    ImGui.Text("A.Section: " .. tostring(st.active_section))
    ImGui.Text("Logic: " .. tostring(st.section_logic))
    ImGui.Text("Ini: " .. tostring(st.ini_filename))
    ImGui.Text("AnimState: " .. tostring(state_mgr.get_state(near)))
    
    -- Path index
    local pt_index = near.get_current_point_index and near:get_current_point_index()
    if not pt_index or pt_index == 4294967296 then
        pt_index = st.active_scheme and (st.active_scheme == "camper" or st.active_scheme == "beh") and load_var(near, "path_index", nil)
    end
    ImGui.Text("PT index: " .. (pt_index and tostring(pt_index) or "None"))
    
    -- Activity info
    local corpse_name = "None"
    if st.corpse_detection and st.corpse_detection.selected_corpse_id then
        local vo = level.object_by_id(st.corpse_detection.selected_corpse_id)
        if vo then
            corpse_name = vo:name()
        end
    end
    ImGui.Text("Looting corpse: " .. corpse_name)
    
    local wounded_name = "None"
    if st.help_wounded and st.help_wounded.selected_id then
        local vo = level.object_by_id(st.help_wounded.selected_id)
        if vo then
            wounded_name = vo:name()
        end
    end
    ImGui.Text("Helping wounded: " .. wounded_name)
    
    local pickup_name = "None"
    if st.gather_items and st.gather_items.selected_id then
        local vo = level.object_by_id(st.gather_items.selected_id)
        if vo then
            pickup_name = vo:name()
        end
    end
    ImGui.Text("Picking up: " .. pickup_name)
    
    -- Enemy info
    local enemy_name = "None"
    local vo = near:best_enemy()
    if vo and vo:alive() and IsStalker(vo) and IsWounded(vo) then
        if db.storage[vo:id()] and db.storage[vo:id()].victim_surrender and db.storage[vo:id()].victim_surrender < 65534 then
            enemy_name = vo:name()
        end
    end
    ImGui.Text("Kill wounded: " .. enemy_name)
    
    -- Distance
    local dist = device().cam_pos:distance_to(near:position())
    ImGui.Text("distance: " .. string.format("%d (%dm)", dist * dist, dist))
    
    -- Restrictions
    ImGui.Text("OUT RESTR: " .. tostring(near:out_restrictions()))
    ImGui.Text("IN RESTR: " .. tostring(near:in_restrictions()))
end

function check_arrived_to_smart(obj, smart)
    if not (obj and smart) then
        return false
    end
    
    local cls = obj and obj.clsid and obj:clsid()
    if not cls then
        return false
    end
    
    local gg = game_graph()
    local obj_gv, obj_pos = gg:vertex(obj.m_game_vertex_id), obj.position
    local smart_gv = gg:vertex(smart.m_game_vertex_id)
    
    if obj_gv:level_id() ~= smart_gv:level_id() then
        return false
    end
    
    if IsHelicopter(nil, cls) then
        return true
    end
    
    local squad = obj.group_id ~= 65535 and alife_object(obj.group_id)
    if squad then
        if squad.m_game_vertex_id == smart.m_game_vertex_id then
            return true
        end
        
        if squad.current_target_id and squad.current_target_id == smart.id then
            return true
        end
        
        if is_squad_monster[squad.player_id] and squad:get_script_target() == nil then
            return squad.position:distance_to_sqr(smart.position) <= 625
        end
        
        return squad.always_arrived or squad.position:distance_to_sqr(smart.position) <= smart.arrive_dist^2
    end
    
    return obj_pos:distance_to_sqr(smart.position) <= 2500
end