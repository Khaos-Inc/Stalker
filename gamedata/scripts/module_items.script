------------------------------------------------------------
-- Debug-spawner weapon loadouts
------------------------------------------------------------
-- Popup grouping comes ONLY from:
--
--   [weapon_debug_variants]
--   wpn_lr300 = wpn_lr300, lr300_tac, m4a1, hk416
--
-- The module lists still come ONLY from:
--
--   [weapon_default_attachments]
--   wpn_lr300 = ...
--   m4a1      = ...
--
-- The debug spawner always spawns the real/base weapon section, then applies
-- the chosen loadout after spawn. This prevents wpn_lr300 factory modules from
-- being kept when choosing m4a1/hk416/etc.

local DEFAULT_ATTACHMENTS_SECTION = "weapon_default_attachments"
local DEBUG_VARIANTS_SECTION      = "weapon_debug_variants"

local function dbg_trim(str)
    if not str then return "" end
    return string.match(tostring(str), "^%s*(.-)%s*$") or ""
end

local function dbg_ini()
    -- Use ini_sys first because the old debug spawner used ini_sys and it sees
    -- the loaded system config sections used by the item spawner.
    if ini_sys then return ini_sys end
    if system_ini then return system_ini() end
    return nil
end

local function dbg_line_exists(ini, section, key)
    if not ini or not section or not key then return false end
    local ok, res = pcall(function() return ini:line_exist(section, key) end)
    return ok and res and true or false
end

local function dbg_section_exists(ini, section)
    if not ini or not section then return false end
    local ok, res = pcall(function() return ini:section_exist(section) end)
    return ok and res and true or false
end

local function dbg_read_string(ini, section, key)
    if not ini or not section or not key then return nil end

    if ini.r_string_ex then
        local ok, res = pcall(function() return ini:r_string_ex(section, key) end)
        if ok and res then return res end
    end

    if ini.r_string then
        local ok, res = pcall(function() return ini:r_string(section, key) end)
        if ok and res then return res end
    end

    return nil
end

local function split_csv_list(str)
    local result = {}
    if not str then return result end

    for token in string.gmatch(tostring(str), "([^,]+)") do
        local trimmed = dbg_trim(token)
        if trimmed ~= "" then
            table.insert(result, trimmed)
        end
    end

    return result
end

local function push_unique(list, seen, name, is_default, modules)
    name = dbg_trim(name)
    if name == "" or seen[name] then return end
    seen[name] = true

    table.insert(list, {
        name = name,
        modules = modules or {},
        is_default = is_default and true or false
    })
end

function get_weapon_default_attachment_loadouts(section)
    local result = {}
    section = dbg_trim(section)
    if section == "" then return result end

    local ini = dbg_ini()
    if not ini then
        printf("DEBUG_SPAWNER_VARIANTS section=[%s] no_ini", tostring(section))
        return result
    end

    local has_defaults = dbg_section_exists(ini, DEFAULT_ATTACHMENTS_SECTION)
    local has_index    = dbg_section_exists(ini, DEBUG_VARIANTS_SECTION)
    local seen = {}

    -- Always add the real weapon section first if it has a default loadout.
    -- This matches old behavior: first popup item is the base weapon.
    if has_defaults and dbg_line_exists(ini, DEFAULT_ATTACHMENTS_SECTION, section) then
        push_unique(
            result,
            seen,
            section,
            true,
            split_csv_list(dbg_read_string(ini, DEFAULT_ATTACHMENTS_SECTION, section))
        )
    end

    -- New explicit popup index. No scanning and no weapon_builds.ltx.
    if has_index and dbg_line_exists(ini, DEBUG_VARIANTS_SECTION, section) then
        local variants = split_csv_list(dbg_read_string(ini, DEBUG_VARIANTS_SECTION, section))

        for _, variant in ipairs(variants) do
            if has_defaults and dbg_line_exists(ini, DEFAULT_ATTACHMENTS_SECTION, variant) then
                push_unique(
                    result,
                    seen,
                    variant,
                    variant == section,
                    split_csv_list(dbg_read_string(ini, DEFAULT_ATTACHMENTS_SECTION, variant))
                )
            else
                -- Keep it visible for debugging even if the actual loadout line
                -- is missing. Selecting it will print a missing-loadout message.
                push_unique(result, seen, variant, variant == section, {})
                printf(
                    "DEBUG_SPAWNER_VARIANTS warning base=[%s] variant=[%s] missing [%s] line",
                    tostring(section),
                    tostring(variant),
                    DEFAULT_ATTACHMENTS_SECTION
                )
            end
        end
    end

    -- Compatibility with your old index name if it is still present. This is
    -- only a fallback when the new [weapon_debug_variants] line is missing.
    if #result <= 1 and dbg_section_exists(ini, "wuut_weapon_variants") and dbg_line_exists(ini, "wuut_weapon_variants", section) then
        local variants = split_csv_list(dbg_read_string(ini, "wuut_weapon_variants", section))
        for _, variant in ipairs(variants) do
            if has_defaults and dbg_line_exists(ini, DEFAULT_ATTACHMENTS_SECTION, variant) then
                push_unique(
                    result,
                    seen,
                    variant,
                    variant == section,
                    split_csv_list(dbg_read_string(ini, DEFAULT_ATTACHMENTS_SECTION, variant))
                )
            end
        end
    end

    printf(
        "DEBUG_SPAWNER_VARIANTS base=[%s] has_index=[%s] has_defaults=[%s] count=[%s]",
        tostring(section),
        tostring(has_index and dbg_line_exists(ini, DEBUG_VARIANTS_SECTION, section)),
        tostring(has_defaults and dbg_line_exists(ini, DEFAULT_ATTACHMENTS_SECTION, section)),
        tostring(#result)
    )

    return result
end

function has_weapon_default_attachment_loadouts(section)
    local loadouts = get_weapon_default_attachment_loadouts(section)
    return loadouts and #loadouts > 1
end

-- Section-only modular check kept for compatibility with other debug code.
function is_modular_weapon_section(section)
    if not section or section == "" then return false end
    if is_magazine_module(section) then return false end

    local ini = dbg_ini()
    if not ini or not dbg_section_exists(ini, section) then return false end
    if not dbg_line_exists(ini, section, "modular_attachments") then return false end

    local ok, res = pcall(function() return ini:r_bool(section, "modular_attachments") end)
    return ok and res and true or false
end

-- [item_id] = selected loadout name to apply once the object appears.
build_post_spawn = {}

local function can_install_module_section(wpn, section)
    if is_magazine_module(section) then
        return weapon_accepts_magazine(wpn, section)
    end

    return wpn.module_can_install and wpn:module_can_install(section)
end

-- Removes every removable/default module from a freshly spawned weapon before
-- a chosen loadout is installed. give_to_actor=false avoids dumping the
-- temporary factory-default parts into the player's inventory.
local function strip_all_removable_modules(wpn, give_to_actor)
    if not wpn or not wpn.module_count or not wpn.module_get_section then return end

    local idx = wpn:module_count() - 1
    local guard = 0

    while idx >= 0 and guard < 128 do
        guard = guard + 1

        if remove_installed_module_exact(wpn, idx, give_to_actor) then
            idx = wpn:module_count() - 1
        else
            idx = idx - 1
        end
    end
end

local function find_loadout_for_weapon(wpn, loadout_name)
    if not wpn or not loadout_name or loadout_name == false then return nil end

    local section = wpn:section()
    local loadouts = get_weapon_default_attachment_loadouts(section)

    if loadout_name == "random" then
        local choices = {}
        for i = 1, #loadouts do
            if not loadouts[i].is_default then
                table.insert(choices, loadouts[i])
            end
        end

        if #choices > 0 then
            return choices[math.random(#choices)]
        end

        return nil
    end

    for i = 1, #loadouts do
        if loadouts[i].name == loadout_name then
            return loadouts[i]
        end
    end

    return nil
end

local function refresh_spawned_weapon_after_loadout(wpn)
    if not wpn then return end

    if wpn.UpdateAddonsVisibility then pcall(function() wpn:UpdateAddonsVisibility() end) end
    if wpn.update_addons_visibility then pcall(function() wpn:update_addons_visibility() end) end
    if wpn.UpdateHUDAddonsVisibility then pcall(function() wpn:UpdateHUDAddonsVisibility() end) end
    if wpn.update_hud_addons_visibility then pcall(function() wpn:update_hud_addons_visibility() end) end
end

local function apply_default_attachment_loadout(wpn, loadout_name)
    local loadout = find_loadout_for_weapon(wpn, loadout_name)
    if not loadout then
        printf(
            "DEBUG_SPAWNER_LOADOUT_APPLY missing base=[%s] loadout=[%s]",
            tostring(wpn and wpn:section()),
            tostring(loadout_name)
        )
        return
    end

    -- Base/default option is just the normal spawned weapon.
    if loadout.is_default then return end

    if not loadout.modules or #loadout.modules == 0 then
        printf(
            "DEBUG_SPAWNER_LOADOUT_APPLY empty base=[%s] loadout=[%s]",
            tostring(wpn and wpn:section()),
            tostring(loadout_name)
        )
        return
    end

    local section = wpn:section()

    printf(
        "DEBUG_SPAWNER_LOADOUT_APPLY base=[%s] loadout=[%s] modules=[%s]",
        tostring(section),
        tostring(loadout.name),
        tostring(#loadout.modules)
    )

    strip_all_removable_modules(wpn, false)

    for _, module_section in ipairs(loadout.modules) do
        if can_install_module_section(wpn, module_section) then
            local ok = wpn:module_install(module_section)
            printf(
                "DEBUG_SPAWNER_LOADOUT_APPLY module=[%s] result=[%s]",
                tostring(module_section),
                ok and "installed" or "failed"
            )
        else
            printf(
                "DEBUG_SPAWNER_LOADOUT_APPLY module=[%s] result=[not_installable]",
                tostring(module_section)
            )
        end
    end

    refresh_spawned_weapon_after_loadout(wpn)
end

local function schedule_build_check(item_id, attempt)
    local event_key = "debug_spawner_loadout_check_" .. tostring(item_id) .. "_" .. tostring(attempt)

    CreateTimeEvent("debug_spawner_loadout_post_spawn", event_key, 0.2, function()
        local loadout_name = build_post_spawn[item_id]

        if loadout_name == nil then
            return true
        end

        local wpn = level.object_by_id(item_id)

        if not wpn then
            if attempt >= 25 then
                printf(
                    "DEBUG_SPAWNER_LOADOUT_APPLY gave up id=[%s] loadout=[%s]",
                    tostring(item_id),
                    tostring(loadout_name)
                )
                build_post_spawn[item_id] = nil
                return true
            end

            schedule_build_check(item_id, attempt + 1)
            return true
        end

        if loadout_name and loadout_name ~= false and loadout_name ~= wpn:section() then
            apply_default_attachment_loadout(wpn, loadout_name)

            -- The engine/default module pass can sometimes happen shortly after
            -- the client object first appears. Re-apply once more so the chosen
            -- debug-spawner loadout wins over the factory default.
            local second_key = "debug_spawner_loadout_second_pass_" .. tostring(item_id)
            CreateTimeEvent("debug_spawner_loadout_post_spawn", second_key, 0.6, function()
                local obj = level.object_by_id(item_id)
                if obj then
                    apply_default_attachment_loadout(obj, loadout_name)
                end
                build_post_spawn[item_id] = nil
                return true
            end)
        else
            build_post_spawn[item_id] = nil
        end

        return true
    end)
end

function SetUpBuildPostSpawn(item_id, loadout_name)
    if not item_id then return end

    build_post_spawn[item_id] = loadout_name or false
    schedule_build_check(item_id, 0)
end
