-- Register this tool
imgui_debug_tools.register_tool("FeelTouchHud", {
    title = "Feel Touch",
    render = function()
        render_feel_touch_hud()
    end,
    visible = false
})

function render_feel_touch_hud()
    local obj = xrs_debug_tools.get_debug_npc()
    ImGui.Text(string.format("-[FEEL TOUCH for %s]-", obj and obj:name() or "No NPC"))
    ImGui.Separator()
    
    if not (obj and obj:alive()) then
        ImGui.Text("No NPC selected or NPC not alive")
        return
    end
    
    local touch_objects = {}
    local itr = function(id)
        local o = id and alife_object(id)
        if (o) then
            table.insert(touch_objects, {id = id, name = o:name()})
        end
    end
    obj:iterate_feel_touch(itr)
    
    if #touch_objects == 0 then
        ImGui.Text("No objects in feel touch range")
        return
    end
    
    local table_flags = 3 -- Borders(1) + RowBg(2)
    if ImGui.BeginTable("NPCFeelTouchTable", 2, table_flags, vector2(0, 0), 0) then
        ImGui.TableSetupColumn("ID", 2, 0, 0) -- 2 = WidthFixed
        ImGui.TableSetupColumn("Name", 2, 0, 0)
        ImGui.TableHeadersRow()
        
        -- Table data
        for _, obj_data in ipairs(touch_objects) do
            ImGui.TableNextRow()
            
            ImGui.TableNextColumn()
            ImGui.Text(tostring(obj_data.id))
            
            ImGui.TableNextColumn()
            ImGui.Text(obj_data.name)
        end
        
        ImGui.EndTable()
    end
end