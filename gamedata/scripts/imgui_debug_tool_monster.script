-- Monster Debug Tool



local function get_nearest_monster(npc)
	local mon
	local dist
	local nearest_stalker, nearest_dist
	local pos
	
	if not (db and db.storage) then
		return nil, nil
	end
	
	for id, st in pairs(db.storage) do
		mon = st.object or (level and level.object_by_id and level.object_by_id(id))
		if (mon and IsMonster and IsMonster(mon) and mon:alive()) then
			pos = npc == "cam" and device and device().cam_pos or mon:position()
			if pos then
				dist = pos:distance_to_sqr(mon:position())
				if not (nearest_dist) then
					nearest_dist = dist
					nearest_stalker = mon
				end

				if (dist < nearest_dist) then
					nearest_dist = dist
					nearest_stalker = mon
				end
			end
		end
	end
	return nearest_stalker, nearest_dist
end

function render()
	local near, dist = get_nearest_monster("cam")
	local near_name = near and near:name() or "No Monster"
	local near_id = near and near:id() or "N/A"
	
	ImGui.Text("Nearest Monster: " .. near_name .. " (ID: " .. tostring(near_id) .. ")")
	ImGui.Separator()
	
	-- Always display monster information
	local has_monster = near and near:alive()
	local st = has_monster and db and db.storage and db.storage[near:id()]
	local sobj = has_monster and alife_object and alife_object(near:id())
	
	-- Basic Monster Information
	ImGui.Text("Basic Monster Information:")
	ImGui.Text("Section Name: " .. (sobj and sobj:section_name() or "N/A"))
	ImGui.Text("ID: " .. tostring(near_id))
	ImGui.Text("Parent ID: " .. ((sobj and sobj.parent_id and sobj.parent_id ~= 65535) and tostring(sobj.parent_id) or "N/A"))
	ImGui.Text("Rank: " .. (has_monster and ranks and ranks.get_obj_rank_name and ranks.get_obj_rank_name(near) or "N/A"))
	ImGui.Text("Visual: " .. (has_monster and near:get_visual_name() or "N/A"))
	ImGui.Text("Health: " .. (has_monster and string.format("%d%%", math.floor(near.health * 100)) or "N/A"))
	ImGui.Text("FOV: " .. (has_monster and string.format("%.2f", near:fov()) or "N/A"))
	ImGui.Text("Range: " .. (has_monster and string.format("%.2f", near:range()) or "N/A"))
	ImGui.Text("Story ID: " .. (has_monster and get_object_story_id and get_object_story_id(near:id()) or "N/A"))
	
	ImGui.Separator()
	
	-- Logic Information
	ImGui.Text("Logic Information:")
	ImGui.Text("Active Scheme: " .. (st and st.active_scheme or "N/A"))
	ImGui.Text("Active Section: " .. (st and st.active_section or "N/A"))
	ImGui.Text("Logic Section: " .. (st and st.section_logic or "N/A"))
	ImGui.Text("INI Filename: " .. (st and st.ini_filename or "N/A"))
	
	ImGui.Separator()
	
	-- Enemy Information
	ImGui.Text("Enemy Information:")
	local best_enemy = has_monster and near:best_enemy()
	local current_enemy = has_monster and near:get_enemy()
	local best_enemy_name = best_enemy and best_enemy:name() or "None"
	local current_enemy_name = current_enemy and current_enemy:name() or "None"
	
	ImGui.Text("Best Enemy: " .. best_enemy_name)
	ImGui.Text("Current Enemy: " .. current_enemy_name)
	
	-- Combat Ignore Conditions
	local combat_ignore_best = "N/A"
	if (st and st.overrides and st.overrides.combat_ignore and best_enemy and xr_logic and xr_logic.pick_section_from_condlist) then
		combat_ignore_best = xr_logic.pick_section_from_condlist(best_enemy, near, st.overrides.combat_ignore.condlist) or "N/A"
	end
	ImGui.Text("Combat Ignore (Best): " .. tostring(combat_ignore_best))
	
	local combat_ignore_current = "N/A"
	if (st and st.overrides and st.overrides.combat_ignore and current_enemy and xr_logic and xr_logic.pick_section_from_condlist) then
		combat_ignore_current = xr_logic.pick_section_from_condlist(current_enemy, near, st.overrides.combat_ignore.condlist) or "N/A"
	end
	ImGui.Text("Combat Ignore (Current): " .. tostring(combat_ignore_current))
	
	ImGui.Separator()
	
	-- Job Information Table
	local smart = sobj and sobj.m_smart_terrain_id and sobj.m_smart_terrain_id ~= 65535 and 
		alife_object and alife_object(sobj.m_smart_terrain_id)
	local npc_info = smart and smart.npc_info and smart.npc_info[near and near:id()]
	
	ImGui.Text("Job Information:")
	ImGui.Text("Has NPC Info: " .. tostring(npc_info ~= nil))
	
	local job_section = "N/A"
	local job_priority = "N/A"
	local job_exclusive = "N/A"
	local job_iterator = "N/A"
	
	if npc_info then
		job_iterator = tostring(npc_info.current_index or "N/A")
		if npc_info.job then
			job_section = npc_info.job.section or "N/A"
			job_priority = gulag_general and gulag_general.get_job_prior and 
				gulag_general.get_job_prior(npc_info.job) or "unknown"
			job_exclusive = tostring(npc_info.job.exclusive or false)
		end
	end
	
	ImGui.Text("Job Section: " .. job_section)
	ImGui.Text("Job Priority: " .. job_priority)
	ImGui.Text("Job Exclusive: " .. job_exclusive)
	ImGui.Text("Job Iterator: " .. job_iterator)
end

-- Tool registration
imgui_debug_tools.register_tool("monster_hud", {
	title = "Monster Info",
	render = render,
	visible = false
})
