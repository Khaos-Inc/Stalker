-- NPC Memory Debug Tool



function render()
	local near = xrs_debug_tools.get_debug_npc and xrs_debug_tools.get_debug_npc()
	local near_name = near and near:name() or "No NPC"
	local near_id = near and near:id() or "N/A"
	
	ImGui.Text("Debug NPC: " .. near_name .. " (ID: " .. tostring(near_id) .. ")")
	ImGui.Separator()
	
	-- Always display memory information
	local has_npc = near and near:alive()
	
	-- Visual Memory Objects Table
	local visual_objects = {}
	if has_npc then
		for o in near:memory_visible_objects() do
			local obj = o:object()
			if obj then
				local memory_time = near:memory_time(obj)
				table.insert(visual_objects, {
					name = obj:name(),
					memory_time = tostring(memory_time)
				})
			end
		end
	end
	
	ImGui.Text("Visual Memory Objects:")
	if ImGui.BeginTable("VisualMemory", 2, 3, vector2(0, 0), 0) then
		ImGui.TableSetupColumn("Object Name")
		ImGui.TableSetupColumn("Memory Time")
		ImGui.TableHeadersRow()

		for _, obj_info in ipairs(visual_objects) do
			ImGui.TableNextRow()
			ImGui.TableSetColumnIndex(0)
			ImGui.Text(obj_info.name)
			ImGui.TableSetColumnIndex(1)
			ImGui.Text(obj_info.memory_time)
		end
		
		ImGui.EndTable()
	end
	
	ImGui.Separator()
	
	-- Sound Memory Objects Table
	local sound_objects = {}
	if has_npc then
		for o in near:memory_sound_objects() do
			local obj = o:object()
			if obj then
				table.insert(sound_objects, {
					name = obj:name()
				})
			end
		end
	end
	
	ImGui.Text("Sound Memory Objects:")
	if ImGui.BeginTable("SoundMemory", 1, 3, vector2(0, 0), 0) then
		ImGui.TableSetupColumn("Object Name")
		ImGui.TableHeadersRow()
		
		for _, obj_info in ipairs(sound_objects) do
			ImGui.TableNextRow()
			ImGui.TableSetColumnIndex(0)
			ImGui.Text(obj_info.name)
		end
		
		ImGui.EndTable()
	end
	
	ImGui.Separator()
	
	-- Summary Information
	ImGui.Text("Memory Summary:")
	ImGui.Text("NPC Available: " .. tostring(has_npc or false))
	ImGui.Text("Visual Objects Count: " .. tostring(#visual_objects))
	ImGui.Text("Sound Objects Count: " .. tostring(#sound_objects))
end

-- Tool registration
imgui_debug_tools.register_tool("npc_memory_hud", {
	title = "NPC Memory",
	render = render,
	visible = false
})
