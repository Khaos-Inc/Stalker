-- Desolation New Age - LTX driven persistent world spawner V3
-- Direct ALife world spawning, matching the vanilla/Oasis spawn path:
-- resolve world position -> level vertex -> alife_create directly in the world.
-- No actor inventory spawn, no live-object wait, no drop_item_and_teleport.

local SPAWN_FILE        = "items\\settings\\deso_world_spawns.ltx"
local VARIANTS_SECTION  = "weapon_debug_variants"
local START_DELAY_MS     = 5000
local DROP_Y_OFFSET      = 1.0
local LOG_NAME           = "deso_world_spawner.log"

local queue = {}
local queue_index = 1
local online_checks = {}
local scan_pending = false
local scan_at = 0
local variant_to_base = {}

local function trim(s)
    if not s then return "" end
    return (tostring(s):gsub("^%s+", ""):gsub("%s+$", ""))
end

local function log_path()
    local ok, p = pcall(function()
        return getFS():update_path("$app_data_root$", LOG_NAME)
    end)
    if ok and p then return p end
    return LOG_NAME
end

local function log(msg, ...)
    local out = msg
    if select('#', ...) > 0 then
        local ok, s = pcall(string.format, msg, ...)
        if ok then out = s end
    end
    printf("[DESO_WORLD_SPAWNER] %s", out)
    local f = io.open(log_path(), "a")
    if f then
        f:write(os.date("[%Y-%m-%d %H:%M:%S] "), out, "\n")
        f:close()
    end
end

local function split_csv(s)
    local t = {}
    if not s then return t end
    for v in tostring(s):gmatch("([^,]+)") do
        v = trim(v)
        if v ~= "" then t[#t + 1] = v end
    end
    return t
end

local function strip_instance_suffix(s)
    -- Optional duplicate syntax: bandage#1, bandage#2, etc.
    return trim((s or ""):gsub("#.*$", ""))
end

local function parse_xyz(s)
    local p = split_csv(s)
    if #p ~= 3 then return nil end
    local x, y, z = tonumber(p[1]), tonumber(p[2]), tonumber(p[3])
    if not x or not y or not z then return nil end
    return x, y, z
end

local function build_variant_index()
    variant_to_base = {}

    if not ini_sys then
        log("ERROR: ini_sys is NIL while building variant index")
        return
    end

    if not ini_sys:section_exist(VARIANTS_SECTION) then
        log("WARNING: [%s] does not exist; normal item sections will still work", VARIANTS_SECTION)
        return
    end

    local n = ini_sys:line_count(VARIANTS_SECTION)
    log("Reading [%s]: %d line(s)", VARIANTS_SECTION, n)

    for i = 0, n - 1 do
        local ok, base, value = ini_sys:r_line_ex(VARIANTS_SECTION, i, "", "")
        if ok and base and base ~= "" then
            base = trim(base)
            variant_to_base[base] = base
            for _, variant in ipairs(split_csv(value)) do
                variant_to_base[variant] = base
            end
        end
    end

    log("Variant index ready")
end

local function resolve_item(name)
    local base = variant_to_base[name]
    if base then
        if base ~= name then return base, name end
        return base, nil
    end

    if ini_sys and ini_sys:section_exist(name) then
        return name, nil
    end

    return nil, nil
end

local function persistence_key(level_name, raw_key, x, y, z)
    -- Top-level ALife state flag, deliberately matching the simple persistence
    -- style used by the original working Easter-egg test.
    return string.format("deso_world_spawn_v6matched|%s|%s|%.6f|%.6f|%.6f",
        level_name, raw_key, x, y, z)
end

local function build_queue()
    queue = {}
    queue_index = 1

    if not db.actor then
        log("ERROR: actor is NIL during spawn-list scan")
        return
    end

    local level_name = level.name()
    log("Scanning spawn list for current level [%s]", tostring(level_name))

    build_variant_index()

    local ok_ini, ltx = pcall(ini_file, SPAWN_FILE)
    if not ok_ini or not ltx then
        log("ERROR: failed to open [%s], pcall_ok=%s result=%s",
            SPAWN_FILE, tostring(ok_ini), tostring(ltx))
        return
    end

    log("LTX opened successfully: [%s]", SPAWN_FILE)

    if not ltx:section_exist(level_name) then
        log("No [%s] section in LTX; nothing to spawn on this map", level_name)
        return
    end

    local ok_state, state = pcall(alife_storage_manager.get_state)
    if not ok_state or not state then
        log("ERROR: alife_storage_manager.get_state failed: %s", tostring(state))
        return
    end

    local count = ltx:line_count(level_name)
    log("Found %d LTX line(s) under [%s]", count, level_name)

    for i = 0, count - 1 do
        local ok, raw_key, value = ltx:r_line_ex(level_name, i, "", "")
        if ok and raw_key and raw_key ~= "" then
            raw_key = trim(raw_key)
            local item = strip_instance_suffix(raw_key)
            local x, y, z = parse_xyz(value)

            if not x then
                log("SKIP line %d: bad XYZ [%s] = [%s]", i, raw_key, tostring(value))
            else
                local base, variant = resolve_item(item)
                if not base then
                    log("SKIP line %d: unknown item/variant [%s]", i, item)
                else
                    local flag = persistence_key(level_name, raw_key, x, y, z)
                    if state[flag] then
                        log("ALREADY SPAWNED: [%s]", raw_key)
                    else
                        queue[#queue + 1] = {
                            raw_key = raw_key,
                            item = item,
                            base = base,
                            variant = variant,
                            x = x, y = y, z = z,
                            flag = flag,
                            state = state,
                        }
                        log("QUEUED: [%s] base=[%s] variant=[%s] pos=(%.6f, %.6f, %.6f)",
                            raw_key, base, tostring(variant), x, y, z)
                    end
                end
            end
        end
    end

    log("Queue ready: %d item(s)", #queue)
end

local function begin_next()
    if queue_index > #queue or not db.actor then return end

    local e = queue[queue_index]
    queue_index = queue_index + 1

    -- Spawn point and navigation vertex are intentionally resolved separately.
    -- Vanilla patrol paths work the same way: the patrol point has a world
    -- position plus a valid precomputed level vertex. Our configured point is
    -- the near-ground reference; +Y is only the physical item placement.
    local pos = vector():set(e.x, e.y + DROP_Y_OFFSET, e.z)

    -- level.vertex_id(pos) only succeeds when the point itself maps cleanly
    -- into the level graph. For arbitrary item coordinates we instead ask the
    -- engine for real navigation vertices around the configured position and
    -- choose the closest one. This gives alife_create() the same kind of valid
    -- level vertex that a baked patrol point would already contain.
    local lvid = nil
    local vertex_pos = nil
    local search_origin = vector():set(e.x, e.y, e.z)
    local search_radii = { 1.0, 2.0, 5.0, 10.0, 20.0, 40.0 }

    for _, radius in ipairs(search_radii) do
        local ok_near, verts = pcall(level.get_nearby_vertices, search_origin, radius)
        if ok_near and verts then
            local best_id = nil
            local best_pos = nil
            local best_d2 = nil

            for id, present in pairs(verts) do
                if present and id ~= nil and id < 4294967295 then
                    local ok_vp, vp = pcall(level.vertex_position, id)
                    if ok_vp and vp then
                        local dx = vp.x - search_origin.x
                        local dy = vp.y - search_origin.y
                        local dz = vp.z - search_origin.z
                        local d2 = dx * dx + dy * dy + dz * dz

                        if best_d2 == nil or d2 < best_d2 then
                            best_d2 = d2
                            best_id = id
                            best_pos = vp
                        end
                    end
                end
            end

            if best_id ~= nil then
                lvid = best_id
                vertex_pos = best_pos
                log("NEAREST NAV VERTEX: item=[%s] radius=%.1f lvid=%s nav_pos=(%.6f, %.6f, %.6f) distance=%.3f",
                    e.item, radius, tostring(lvid),
                    vertex_pos.x, vertex_pos.y, vertex_pos.z,
                    math.sqrt(best_d2))
                break
            end
        end
    end

    if lvid == nil then
        log("ERROR: no navigation vertex found within 40m of [%s] config pos=(%.6f, %.6f, %.6f); spawn pos=(%.6f, %.6f, %.6f)",
            e.item, e.x, e.y, e.z, pos.x, pos.y, pos.z)
        return
    end

    -- Resolve the ALife game-graph vertex that actually corresponds to the
    -- chosen level-graph vertex. Patrol paths already carry this exact pair;
    -- for arbitrary XYZ we derive the game vertex through the cross table.
    local ok_gvid, gvid = pcall(level.game_vertex_id, lvid)
    if not ok_gvid or gvid == nil or gvid >= 65535 then
        log("ERROR: could not resolve matching game vertex for [%s] lvid=%s: ok=%s gvid=%s",
            e.item, tostring(lvid), tostring(ok_gvid), tostring(gvid))
        return
    end

    log("VERTEX RESOLVE: item=[%s] lvid=%s vertex_pos=(%.6f, %.6f, %.6f) spawn_pos=(%.6f, %.6f, %.6f) matched_gvid=%s",
        e.item, tostring(lvid), vertex_pos.x, vertex_pos.y, vertex_pos.z, pos.x, pos.y, pos.z, tostring(gvid))

    log("DIRECT ALIFE CREATE: item=[%s] base=[%s] pos=(%.6f, %.6f, %.6f) lvid=%s gvid=%s",
        e.item, e.base, pos.x, pos.y, pos.z, tostring(lvid), tostring(gvid))

    local ok_spawn, se_obj = pcall(alife_create, e.base, pos, lvid, gvid)
    log("alife_create: ok=%s object=%s", tostring(ok_spawn), tostring(se_obj))

    if not ok_spawn or not se_obj then
        log("ERROR: direct world creation failed for [%s]", e.item)
        return
    end

    local id = se_obj.id
    log("SERVER OBJECT CREATED DIRECTLY IN WORLD: id=%s", tostring(id))

    local ok_can, can_online = pcall(function() return se_obj:can_switch_online() end)
    log("can_switch_online: ok=%s result=%s", tostring(ok_can), tostring(can_online))

    local ok_force, force_err = pcall(utils_obj.switch_online, id)
    log("FORCE ONLINE: id=%s ok=%s error/result=%s", tostring(id), tostring(ok_force), tostring(force_err))

    online_checks[id] = {
        item = e.item,
        x = pos.x, y = pos.y, z = pos.z,
        started = time_global(),
        last_log = 0,
    }

    if e.variant then
        log("APPLY VARIANT: [%s] id=%s", e.variant, tostring(id))
        local ok_variant, err = pcall(module_items.SetUpBuildPostSpawn, id, e.variant)
        log("variant result: ok=%s error/result=%s", tostring(ok_variant), tostring(err))
        if not ok_variant then
            log("ERROR: variant application failed; releasing spawned object; spawn flag NOT set")
            pcall(alife_release, se_obj)
            return
        end
    end

    e.state[e.flag] = true
    log("SUCCESS: [%s] spawned directly in world; persistence flag set", e.raw_key)
end

local function actor_on_first_update()
    scan_pending = true
    scan_at = time_global() + START_DELAY_MS
    log("actor_on_first_update: level=[%s]; scan scheduled in %d ms",
        tostring(level.name()), START_DELAY_MS)
end

local function actor_on_update()
    if scan_pending and time_global() >= scan_at then
        scan_pending = false
        log("Initial delay elapsed; reading LTX now")
        local ok, err = pcall(build_queue)
        if not ok then
            log("FATAL during build_queue: %s", tostring(err))
        end
    end

    -- Spawn one queued entry per update.
    local ok_begin, err_begin = pcall(begin_next)
    if not ok_begin then
        log("FATAL during begin_next: %s", tostring(err_begin))
    end

    -- Verify that directly-created ALife objects actually switch online.
    for id, chk in pairs(online_checks) do
        local obj = level.object_by_id(id)
        if obj then
            local p = obj:position()
            log("LIVE OBJECT READY: item=[%s] id=%s pos=(%.6f, %.6f, %.6f) expected=(%.6f, %.6f, %.6f)",
                chk.item, tostring(id), p.x, p.y, p.z, chk.x, chk.y, chk.z)
            online_checks[id] = nil
        elseif time_global() - chk.started > 5000 then
            log("ONLINE TIMEOUT: item=[%s] id=%s never became level.object_by_id after force-online",
                chk.item, tostring(id))
            online_checks[id] = nil
        end
    end
end

function on_game_start()
    log("on_game_start FIRED [V7 DIRECT ALIFE FORCE ONLINE]")
    RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
    RegisterScriptCallback("actor_on_update", actor_on_update)
    log("Callbacks registered")
    log("Spawn file: [%s]", SPAWN_FILE)
    log("Debug log: [%s]", log_path())
end
