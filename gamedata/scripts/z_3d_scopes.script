--[[
	=====================================================================
	Addon      : Shader 3D Scopes
	Link       : https://www.moddb.com/mods/stalker-anomaly/addons/shader-3d-scopes
	Author     : party_50
	Date       : 01.03.2024
	Last Edit  : 11.03.2025
	=====================================================================
--]]


local ZOOM_FACTOR
local NVG_BLUR
local PARALLAX_SHADOW
local SEE_THROUGH
local THERMAL_PIXELATION
local CHROMATISM
local HOLO_RETICLE_SIZE
local INERTIA_WEIGHT_LENGTH_KOEFF

local ALL_PARAMETERS = {
	s3ds_reticle_size = "float",
	s3ds_eye_relief = "float",
	s3ds_exit_pupil = "float",
	s3ds_ffp = "float",
	
	s3ds_reflection_hue = "float",
	s3ds_min_zoom_1x = "float",
	
	s3ds_image_type = "float",
	s3ds_reticle_type = "float",
	s3ds_dirt_intensity = "float",
	s3ds_chroma_power = "float",
	
	s3ds_lens_color = "s3ds_color"
}

local last_weapon_id
local last_scope

-- Runtime thermal palette override. The configured image type remains the
-- default; pressing the bound Custom 25 action toggles thermal optics between
-- monochrome (2) and color (3) without detaching the scope.
local thermal_palette_by_scope = {}


local inventory_upgrade_base = ui_inventory.UIInventory.RMode_UpgradeYes
local workshop_upgrade_base = ui_workshop.UIWorkshopUpgrade.Upgrade

function ui_inventory.UIInventory:RMode_UpgradeYes()
	inventory_upgrade_base(self)
	last_weapon_id = nil
end

function ui_workshop.UIWorkshopUpgrade:Upgrade()
	workshop_upgrade_base(self)
	last_weapon_id = nil
end


function on_option_change()
	ZOOM_FACTOR = z_3d_scopes_mcm.get_config("zoom_factor")
	NVG_BLUR = z_3d_scopes_mcm.get_config("nvg_blur")
	PARALLAX_SHADOW = z_3d_scopes_mcm.get_config("parallax_shadow")
	SEE_THROUGH = z_3d_scopes_mcm.get_config("see_through")
	THERMAL_PIXELATION = z_3d_scopes_mcm.get_config("thermal_pixelation")
	CHROMATISM = z_3d_scopes_mcm.get_config("chromatism")
	HOLO_RETICLE_SIZE = tonumber(z_3d_scopes_mcm.get_config("holo_reticle_size")) or 0.75
	INERTIA_WEIGHT_LENGTH_KOEFF = tonumber(z_3d_scopes_mcm.get_config("inertia_weight_length_koeff")) or 1.0
	get_console():execute("inertion_weight_length_koeff " .. tostring(INERTIA_WEIGHT_LENGTH_KOEFF))

	last_weapon_id = nil
end

function get_sight_section(wpn)
	local wpn_section = wpn:section()
	
	local modular_attachments = ini_sys:r_bool_ex(wpn_section, "modular_attachments", false)
	if modular_attachments then
		local c_wpn = wpn:cast_Weapon()
		-- Some active items (for example the bolt) can inherit/configure
		-- modular_attachments but are not CWeapon objects. Never call weapon
		-- methods unless the engine cast actually succeeded.
		if not c_wpn then
			return nil
		end
		if c_wpn['IsScopeAttached'](c_wpn) then
			return c_wpn['GetScopeName'](c_wpn)
		end
		return nil
	end

	local parent = ini_sys:r_string_ex(wpn_section, "parent_section") or wpn_section
	if #parent == #wpn_section then
		return wpn_section
	end

	return wpn_section:sub(#parent + 2)
end

function parse_key(section, key, type)
	if type == "float" then
		return ini_sys:r_float_ex(section, key)
	elseif type == "s3ds_color" then
		local value = ini_sys:r_string_ex(section, key)
		if value then
			local color = ini_sys:r_string_ex("s3ds_colors", tostring(value))
			if not color then
				error("Unable to find color " .. tostring(value) .. " in s3ds_colors")
			end
			return tostring(color)
		end
	end
end

function parse_parameters(wpn)
	local values = {}
	wpn:iterate_installed_upgrades(
		function(upgr_sec)
			for key, type in pairs(ALL_PARAMETERS) do
				local value = parse_key(upgr_sec, key, type)
				if value ~= nil then
					values[key] = value
				end
			end
		end
	)
	
	local wpn_section = wpn:section()
	local sight_section = get_sight_section(wpn)
	local modular_attachments = ini_sys:r_bool_ex(wpn_section, "modular_attachments", false)

	for key, type in pairs(ALL_PARAMETERS) do
		-- Desolation modular weapons take S3DS data from the actually installed
		-- scope module first. Non-modular S3DS weapons keep the original
		-- weapon-section-first behaviour.
		if not values[key] and modular_attachments and sight_section then
			values[key] = parse_key(sight_section, key, type)
		end
		if not values[key] then
			values[key] = parse_key(wpn_section, key, type)
		end
		if not values[key] and not modular_attachments and sight_section then
			values[key] = parse_key(sight_section, key, type)
		end
		if not values[key] then
			values[key] = parse_key("s3ds_defaults", key, type)
		end
	end
	
	return values
end

function get(info, key, default)
	if info[key] then
		return info[key]
	end
	return default
end

function pack_binary_settings()
	return (NVG_BLUR and 1 or 0)
		+ (PARALLAX_SHADOW and 1 or 0) * 2
		+ (SEE_THROUGH and 1 or 0) * 4
		+ (THERMAL_PIXELATION and 1 or 0) * 8
		+ (CHROMATISM and 1 or 0) * 16
end

local function get_scope_runtime_key(wpn)
	local scope = get_sight_section(wpn) or ""
	return tostring(wpn:id()) .. ":" .. scope
end

local function get_runtime_image_type(wpn, info)
	local configured = tonumber(get(info, "s3ds_image_type", "0")) or 0
	configured = math.floor(configured + 0.5)

	if configured ~= 2 and configured ~= 3 then
		thermal_palette_by_scope[get_scope_runtime_key(wpn)] = nil
		return configured
	end

	return thermal_palette_by_scope[get_scope_runtime_key(wpn)] or configured
end

function update_shader(wpn)
	local info = parse_parameters(wpn)
	local image_type = get_runtime_image_type(wpn, info)
	
	get_console():execute(
		"s3ds_param_1 " .. 
		get(info, "s3ds_reticle_size", "0") .. ", " ..
		get(info, "s3ds_eye_relief", "0") .. ", " ..
		get(info, "s3ds_exit_pupil", "0") .. ", " ..
		get(info, "s3ds_ffp", "0"))
	
	get_console():execute(
		"s3ds_param_2 " .. 
		get(info, "s3ds_reflection_hue", "0") .. ", " ..
		(HOLO_RETICLE_SIZE or 0.75) .. ", " ..
		get(info, "s3ds_min_zoom_1x", "0") .. ", " ..
		(ZOOM_FACTOR or 1.5))
	
	get_console():execute(
		"s3ds_param_3 " ..
		image_type .. ", " ..
		get(info, "s3ds_reticle_type", "0") .. ", " ..
		get(info, "s3ds_dirt_intensity", "0") .. ", " ..
		get(info, "s3ds_chroma_power", "0"))
	
	get_console():execute(
		"s3ds_param_4 " .. 
		get(info, "s3ds_lens_color", "0, 0, 0") .. ", " ..
		pack_binary_settings())
end



local function on_thermal_palette_key(key)
	if not (key_bindings and key_bindings.kCUSTOM25 and dik_to_bind) then
		return
	end

	if dik_to_bind(key) ~= key_bindings.kCUSTOM25 then
		return
	end

	if not (db.actor and db.actor:alive()) then
		return
	end

	local wpn = db.actor:active_item()
	if not wpn then
		return
	end

	local c_wpn = wpn:cast_Weapon()
	if not c_wpn then
		return
	end

	local info = parse_parameters(wpn)
	local configured = tonumber(get(info, "s3ds_image_type", "0")) or 0
	configured = math.floor(configured + 0.5)

	if configured ~= 2 and configured ~= 3 then
		return
	end

	local runtime_key = get_scope_runtime_key(wpn)
	local current = thermal_palette_by_scope[runtime_key] or configured
	thermal_palette_by_scope[runtime_key] = current == 2 and 3 or 2
	update_shader(wpn)
end

function actor_on_update()
	if not (db.actor and db.actor:alive()) then
		return
	end
	
	local wpn = db.actor:active_item()
	if not wpn then
		last_weapon_id = nil
		return
	end

	local c_wpn = wpn:cast_Weapon()
	if not c_wpn then
		-- Shader 3D Scopes only applies to actual weapon objects. Active
		-- inventory items such as the bolt must not enter weapon parsing.
		last_weapon_id = nil
		last_scope = nil
		return
	end
	
	if not last_weapon_id or last_weapon_id ~= wpn:id() then
		last_weapon_id = wpn:id()
		update_shader(wpn)
	end
	
	local scope
	if c_wpn then
		scope = c_wpn['GetScopeName'](c_wpn)
	end
	if last_scope ~= scope then
		last_scope = scope
		update_shader(wpn)
	end
end

function on_game_start()
	on_option_change()
	RegisterScriptCallback("on_option_change", on_option_change)
	RegisterScriptCallback("actor_on_update", actor_on_update)
	RegisterScriptCallback("on_key_press", on_thermal_palette_key)
end
