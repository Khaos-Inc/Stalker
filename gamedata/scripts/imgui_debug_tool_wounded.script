-- Wounded Debug Tool



function render()
	-- Always display wound information
	local obj = xrs_debug_tools.get_debug_npc and xrs_debug_tools.get_debug_npc()
	local obj_name = obj and obj:name() or "No NPC"
	local obj_id = obj and obj:id() or "N/A"
	local has_obj = obj and obj:alive()
	
	ImGui.Text("Debug NPC: " .. obj_name .. " (ID: " .. tostring(obj_id) .. ")")
	ImGui.Separator()
	
	-- Wound Information Table
	local wound_data = {}
	local st = has_obj and db and db.storage and db.storage[obj:id()]
	local tg = time_global and time_global()
	
	if st then
		-- Is wounded check
		local is_wounded = xr_wounded and xr_wounded.is_wounded and xr_wounded.is_wounded(obj)
		if is_wounded then
			table.insert(wound_data, {"Is Wounded", "true"})
			table.insert(wound_data, {"Helper ID", tostring(st.wounded_already_selected or "N/A")})
		else
			table.insert(wound_data, {"Is Wounded", "false"})
		end
		
		-- Help wounded info
		if st.help_wounded then
			local vo = st.help_wounded.selected_id and level and level.object_by_id and level.object_by_id(st.help_wounded.selected_id)
			table.insert(wound_data, {"Help Wounded Victim", vo and vo:name() or "N/A"})
			table.insert(wound_data, {"Help Wounded Vertex", tostring(st.help_wounded.vertex_id or "N/A")})
			table.insert(wound_data, {"Help Wounded Stage", tostring(st.help_wounded.stage or "N/A")})
		else
			table.insert(wound_data, {"Help Wounded", "Not active"})
		end
		
		-- Kill wounded info
		if st.kill_wounded then
			local vo = st.kill_wounded.current_id and level and level.object_by_id and level.object_by_id(st.kill_wounded.current_id)
			table.insert(wound_data, {"Kill Wounded Victim", vo and vo:name() or "N/A"})
			local timer_val = "N/A"
			if st.kill_wounded.timer and tg then
				timer_val = tostring(st.kill_wounded.timer - tg)
			end
			table.insert(wound_data, {"Kill Wounded Timer", timer_val})
			table.insert(wound_data, {"Kill Wounded Weapon", st.kill_wounded.weapon and st.kill_wounded.weapon:name() or "N/A"})
		else
			table.insert(wound_data, {"Kill Wounded", "Not active"})
		end
		
		-- Victim surrender info
		if st.victim_surrender then
			local po = level and level.object_by_id and level.object_by_id(st.victim_surrender)
			table.insert(wound_data, {"Surrender to", po and po:name() or "N/A"})
		else
			table.insert(wound_data, {"Victim Surrender", "Not active"})
		end
	end
	
	-- Wound Information
	local is_wounded = "false"
	local helper_id = "N/A"
	local help_wounded_victim = "N/A"
	local help_wounded_vertex = "N/A"
	local help_wounded_stage = "N/A"
	local kill_wounded_victim = "N/A"
	local kill_wounded_timer = "N/A"
	local kill_wounded_weapon = "N/A"
	local surrender_to = "N/A"
	
	if st then
		-- Is wounded check
		local wounded_check = xr_wounded and xr_wounded.is_wounded and xr_wounded.is_wounded(obj)
		if wounded_check then
			is_wounded = "true"
			helper_id = tostring(st.wounded_already_selected or "N/A")
		end
		
		-- Help wounded info
		if st.help_wounded then
			local vo = st.help_wounded.selected_id and level and level.object_by_id and level.object_by_id(st.help_wounded.selected_id)
			help_wounded_victim = vo and vo:name() or "N/A"
			help_wounded_vertex = tostring(st.help_wounded.vertex_id or "N/A")
			help_wounded_stage = tostring(st.help_wounded.stage or "N/A")
		else
			help_wounded_victim = "Not active"
		end
		
		-- Kill wounded info
		if st.kill_wounded then
			local vo = st.kill_wounded.current_id and level and level.object_by_id and level.object_by_id(st.kill_wounded.current_id)
			kill_wounded_victim = vo and vo:name() or "N/A"
			if st.kill_wounded.timer and tg then
				kill_wounded_timer = tostring(st.kill_wounded.timer - tg)
			end
			kill_wounded_weapon = st.kill_wounded.weapon and st.kill_wounded.weapon:name() or "N/A"
		else
			kill_wounded_victim = "Not active"
		end
		
		-- Victim surrender info
		if st.victim_surrender then
			local po = level and level.object_by_id and level.object_by_id(st.victim_surrender)
			surrender_to = po and po:name() or "N/A"
		else
			surrender_to = "Not active"
		end
	elseif not has_obj then
		is_wounded = "NPC not available"
	else
		is_wounded = "No storage data"
	end
	
	ImGui.Text("Wound Information:")
	ImGui.Text("Is Wounded: " .. is_wounded)
	ImGui.Text("Helper ID: " .. helper_id)
	ImGui.Text("Help Wounded Victim: " .. help_wounded_victim)
	ImGui.Text("Help Wounded Vertex: " .. help_wounded_vertex)
	ImGui.Text("Help Wounded Stage: " .. help_wounded_stage)
	ImGui.Text("Kill Wounded Victim: " .. kill_wounded_victim)
	ImGui.Text("Kill Wounded Timer: " .. kill_wounded_timer)
	ImGui.Text("Kill Wounded Weapon: " .. kill_wounded_weapon)
	ImGui.Text("Surrender to: " .. surrender_to)
end

-- Tool registration
imgui_debug_tools.register_tool("wounded_hud", {
	title = "Wounded Info",
	render = render,
	visible = false
})
