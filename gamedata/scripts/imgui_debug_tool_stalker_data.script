-- Stalker Data Debug Tool

local stalker_id
local stalker_data = {}


function render()
	local obj = xrs_debug_tools.get_debug_npc()
	local obj_name = obj and obj:alive() and obj:name() or "No NPC"
	local obj_id = obj and obj:alive() and obj:id() or "N/A"
	
	ImGui.Text("Target NPC: " .. obj_name .. " (ID: " .. tostring(obj_id) .. ")")
	ImGui.Separator()
	
	-- Always display conditional information, even if no valid NPC
	if (obj and obj:alive()) then
		if (stalker_id ~= obj:id()) then
			stalker_id = obj:id()
			local se_obj = alife_object(stalker_id)
			if (se_obj) then
				stalker_data = utils_stpk.get_stalker_data(se_obj)
			end
		end
	end
	
	-- Basic Information
	ImGui.Text("Basic Information:")
	ImGui.Text("Character Name: " .. tostring(stalker_data.character_name or "N/A"))
	ImGui.Text("Specific Character: " .. tostring(stalker_data.specific_character or "N/A"))
	ImGui.Text("Profile: " .. tostring(stalker_data.character_profile or "N/A"))
	ImGui.Text("Money: " .. tostring(stalker_data.money or "N/A"))
	ImGui.Text("Community Index: " .. tostring(stalker_data.community_index or "N/A"))
	ImGui.Text("Reputation: " .. tostring(stalker_data.reputation or "N/A"))
	ImGui.Text("Rank: " .. tostring(stalker_data.rank or "N/A"))
	
	ImGui.Separator()
	
	-- Technical Information
	ImGui.Text("Technical Information:")
	ImGui.Text("Visual: " .. tostring(stalker_data.visual_name or "N/A"))
	ImGui.Text("Visual Flags: " .. tostring(stalker_data.visual_flags or "N/A"))
	ImGui.Text("Skeleton: " .. tostring(stalker_data.skeleton_name or "N/A"))
	ImGui.Text("Skeleton Flag: " .. tostring(stalker_data.skeleton_flag or "N/A"))
	ImGui.Text("Team: " .. tostring(stalker_data.g_team or "N/A"))
	ImGui.Text("Squad: " .. tostring(stalker_data.g_squad or "N/A"))
	ImGui.Text("Group: " .. tostring(stalker_data.g_group or "N/A"))
	
	ImGui.Separator()
	
	-- Equipment Preferences
	ImGui.Text("Equipment Preferences:")
	local equip_prefs = stalker_data.equipment_preferences or {}
	if ImGui.BeginTable("EquipmentPrefs", 2, 3, vector2(0, 0), 0) then
		ImGui.TableSetupColumn("Index")
		ImGui.TableSetupColumn("Equipment")
		ImGui.TableHeadersRow()
		
		for k, v in ipairs(equip_prefs) do
			ImGui.TableNextRow()
			ImGui.TableSetColumnIndex(0)
			ImGui.Text(tostring(k))
			ImGui.TableSetColumnIndex(1)
			ImGui.Text(tostring(v))
		end
		
		ImGui.EndTable()
	end
	
	ImGui.Separator()
	
	-- Weapon Preferences
	ImGui.Text("Weapon Preferences:")
	local weapon_prefs = stalker_data.weapon_preferences or {}
	if ImGui.BeginTable("WeaponPrefs", 2, 3, vector2(0, 0), 0) then
		ImGui.TableSetupColumn("Index")
		ImGui.TableSetupColumn("Weapon")
		ImGui.TableHeadersRow()
		
		for k, v in ipairs(weapon_prefs) do
			ImGui.TableNextRow()
			ImGui.TableSetColumnIndex(0)
			ImGui.Text(tostring(k))
			ImGui.TableSetColumnIndex(1)
			ImGui.Text(tostring(v))
		end
		
		ImGui.EndTable()
	end
	
	ImGui.Separator()
	
	-- Restrictions
	ImGui.Text("Restrictions:")
	ImGui.Text("Out Restrictors: " .. tostring(stalker_data.base_out_restrictors or "N/A"))
	ImGui.Text("In Restrictors: " .. tostring(stalker_data.base_in_restrictors or "N/A"))
	local lum_hemi = obj and obj.get_luminocity_hemi and obj:get_luminocity_hemi() or "N/A"
	ImGui.Text("Luminocity Hemi: " .. tostring(lum_hemi))
	local lum = obj and obj.get_luminocity and obj:get_luminocity() or "N/A"
	ImGui.Text("Luminocity: " .. tostring(lum))
end

-- Tool registration
imgui_debug_tools.register_tool("stalker_data_hud", {
	title = "Stalker Data",
	render = render,
	visible = false
})
