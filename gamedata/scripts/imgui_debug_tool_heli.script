-- Register this tool
imgui_debug_tools.register_tool("HeliHud", {
    title = "Helicopter Info",
    render = function()
        render_heli_hud()
    end,
    visible = false
})

function get_nearest_heli(npc)
    local nearest_heli, nearest_dist
    local observer_pos = npc == "cam" and device().cam_pos or nil
    
    for id, st in pairs(db.storage) do
        local mon = st.object or level.object_by_id(id)
        if not (mon and IsHelicopter(mon)) then
            goto continue
        end
        
        local pos = observer_pos or mon:position()
        local dist = pos:distance_to_sqr(mon:position())
        
        if not nearest_dist or dist < nearest_dist then
            nearest_dist = dist
            nearest_heli = mon
        end
        
        ::continue::
    end
    
    return nearest_heli, nearest_dist
end

function render_heli_hud()   
    local heli = get_nearest_heli("cam")
    if not heli then
        ImGui.Text("No helicopter found nearby")
        render_smart_terrain_info()
        return
    end
    
    ImGui.Text("Name: " .. tostring(heli:name()))
    
    local st = db.storage[heli:id()]
    if not st then
        ImGui.Text("No db.storage data found for helicopter")
        render_smart_terrain_info()
        return
    end
    
    -- Basic helicopter info
    ImGui.Text("A.Scheme: " .. tostring(st.active_scheme))
    ImGui.Text("A.Section: " .. tostring(st.active_section))
    ImGui.Text("Logic: " .. tostring(st.section_logic))
    ImGui.Text("Ini: " .. tostring(st.ini_filename))
    
    render_server_entity_info(heli)
    render_enemy_info(st)
    render_combat_info(st)
    render_smart_terrain_info()
end

function render_server_entity_info(heli)
    local sim = alife()
    local se_heli = sim:object(heli:id())
    
    -- Target information
    local assigned_target = se_heli and se_heli.assigned_target_id and sim:object(se_heli.assigned_target_id)
    ImGui.Text("Assigned Target: " .. (assigned_target and tostring(assigned_target:name()) or "None"))
    
    local current_target = se_heli and se_heli.current_target_id and sim:object(se_heli.current_target_id)
    local current_target_name = current_target and tostring(current_target:name()) or "None"
    ImGui.Text("Current Target: " .. current_target_name)
    
    -- Action information
    local action_text = "None"
    local stay_time_text = "N/A"
    if se_heli and se_heli.current_action then
        action_text = se_heli.current_action == 0 and "Stay Point" or "Reach Target"
        
        if se_heli.current_action == 0 and se_heli.stay_point_idle then
            local stay_time = 1800 - game.get_game_time():diffSec(se_heli.stay_point_idle)
            stay_time_text = tostring(stay_time)
        end
    end
    ImGui.Text("Current Action: " .. action_text)
    ImGui.Text("Stay Time: " .. stay_time_text)
    
    -- Smart terrain information
    local smart = se_heli and se_heli.m_smart_terrain_id and alife_object(se_heli.m_smart_terrain_id)
    ImGui.Text("Smart: " .. (smart and tostring(smart:name()) or "None"))
    
    local itr_text = "N/A"
    local job_text = "None"
    if smart then
        local npc_info = smart.npc_info[se_heli.id]
        if npc_info then
            itr_text = tostring(npc_info.current_index or "N/A")
            if npc_info.job then
                job_text = tostring(npc_info.job.section)
            end
        end
    end
    ImGui.Text("itr: " .. itr_text)
    ImGui.Text("Job: " .. job_text)
end

function render_enemy_info(st)
    local enemy_name = "None"
    if st.enemy_id then
        local enemy = db.storage[st.enemy_id] and db.storage[st.enemy_id].object
        if enemy then
            enemy_name = tostring(enemy:name())
        end
    end
    ImGui.Text("Enemy: " .. enemy_name)
    
    local heli_enemy_flag = load_var(db.actor, "heli_enemy_flag", false)
    ImGui.Text("ActorFlaggedEnemy: " .. (heli_enemy_flag and tostring(heli_enemy_flag) or "False"))
end

function render_combat_info(st)
    local combat_types = {
        [0] = "flyby",
        [1] = "round",
        [2] = "search",
        [3] = "retreat"
    }
    
    local combat_type_text = "None"
    local flyby_state_text = "N/A"
    local flyby_passes_text = "N/A"
    
    if st.combat and st.combat.combat_type then
        combat_type_text = tostring(combat_types[st.combat.combat_type] or "Unknown")
        
        if st.combat.combat_type == 0 then
            local flyby_states = {
                [0] = "flyby_state_to_attack_dist",
                [1] = "flyby_state_to_enemy"
            }
            flyby_state_text = tostring(flyby_states[st.combat.state] or "Unknown")
            flyby_passes_text = tostring(st.combat.flyby_states_for_one_pass or "N/A")
        end
    end
    
    ImGui.Text("Combat Type: " .. combat_type_text)
    ImGui.Text("Flyby State: " .. flyby_state_text)
    ImGui.Text("flyby_states_for_one_pass: " .. flyby_passes_text)
end

function render_smart_terrain_info()
    ImGui.Separator()
    
    local smart_terrain_name = "None"
    local has_jobs = false
    
    if smart_terrain.nearest_to_actor_smart and smart_terrain.nearest_to_actor_smart.id then
        local smart = alife_object(smart_terrain.nearest_to_actor_smart.id)
        if smart then
            smart_terrain_name = tostring(smart:name())
            if smart.heli_jobs and #smart.heli_jobs > 0 then
                has_jobs = true
                ImGui.Text("Smart Terrain: " .. smart_terrain_name)
                ImGui.Text("Heli Jobs:")
                
                local table_flags = 3 -- Borders(1) + RowBg(2)
                if ImGui.BeginTable("HeliJobsTable", 3, table_flags, vector2(0, 0), 0) then
                    ImGui.TableSetupColumn("Section", 2, 0, 0) -- 2 = WidthFixed
                    ImGui.TableSetupColumn("Status", 2, 0, 0)
                    ImGui.TableHeadersRow()
                    
                    for i = 1, #smart.heli_jobs do
                        local job = smart.heli_jobs[i]
                        local sec = string.gsub(job.section, "logic@", "")
                        local status = smart.npc_by_job_section[job.section] or "empty"
                        
                        ImGui.TableNextRow()
                        
                        ImGui.TableNextColumn()
                        ImGui.Text(sec)
                        
                        ImGui.TableNextColumn()
                        ImGui.Text(status)
                    end
                    
                    ImGui.EndTable()
                end
            end
        end
    end
    
    if not has_jobs then
        ImGui.Text("Smart Terrain: " .. smart_terrain_name)
        ImGui.Text("Heli Jobs: None available")
    end
end
