-- Actor Info Debug Tool



function render()
	-- Always display actor info portions
	local has_alife = alife and alife()
	local actor_id = db and db.actor and db.actor:id() or 0
	
	ImGui.Text("Actor ID: " .. tostring(actor_id))
	ImGui.Separator()
	
	-- Info Portions Table
	local info_portions = {}
	if has_alife then
		local function itr(id, info)
			table.insert(info_portions, info)
		end
		alife():iterate_info(actor_id, itr)
	end
	
	ImGui.Text("Actor Info Portions:")
	if #info_portions <= 0 then
		ImGui.Text(has_alife and "No info portions" or "ALife not available")
	end

	if ImGui.BeginTable("ActorInfo", 1, 3, vector2(0, 0), 0) then
		ImGui.TableSetupColumn("Info Portion")
		ImGui.TableHeadersRow()
		
		for i, info in ipairs(info_portions) do
			ImGui.TableNextRow()
			ImGui.TableSetColumnIndex(0)
			ImGui.Text(info)
		end
		
		ImGui.EndTable()
	end
	
	ImGui.Separator()
	
	-- Summary Information
	ImGui.Text("Summary:")
	ImGui.Text("ALife Available: " .. tostring(not not has_alife))
	ImGui.Text("Info Portions Count: " .. tostring(#info_portions))
end

-- Tool registration
imgui_debug_tools.register_tool("actor_info_hud", {
	title = "Actor Info",
	render = render,
	visible = false
})
