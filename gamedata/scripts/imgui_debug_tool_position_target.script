-- Position Target Debug Tool

local TARGET_HUD_OLD_ID


function render()
	local obj = level and level.get_target_obj and level.get_target_obj()
	if not obj then 
		obj = TARGET_HUD_OLD_ID and level and level.object_by_id and level.object_by_id(TARGET_HUD_OLD_ID)
	end
	
	local obj_name = obj and obj:name() or "No Target"
	local obj_id = obj and obj:id() or "N/A"
	
	ImGui.Text("Target Object: " .. obj_name .. " (ID: " .. tostring(obj_id) .. ")")
	ImGui.Separator()
	
	-- Always display position information, even if no valid target
	local se_obj, lvid, gvid, pos, dir, angle, pos2, valid, dist, section, visual
	local lvid_from_pos, pos_from_vertex
	
	if (obj) then
		se_obj = alife_object and alife_object(obj:id())
		TARGET_HUD_OLD_ID = obj:id()
		if (se_obj) then
			lvid, gvid = obj:level_vertex_id(), obj:game_vertex_id()
			pos = obj:position()
			dir = obj:direction()
			angle = se_obj.angle
			pos2 = level and level.vertex_position and level.vertex_position(lvid)
			valid = pos2 and pos2:distance_to(pos) <= 0.7
			dist = level and level.get_target_dist and level.get_target_dist()
			section = obj:section()
			visual = obj:get_visual_name()
			lvid_from_pos = level and level.vertex_id and level.vertex_id(pos)
			pos_from_vertex = pos2
		end
	end
	
	-- Basic Information
	ImGui.Text("Basic Information:")
	ImGui.Text("Name: " .. obj_name)
	ImGui.Text("Section: " .. tostring(section or "N/A"))
	ImGui.Text("Visual: " .. tostring(visual or "N/A"))
	local dist_str = dist and string.format("%.3f", dist) or "N/A"
	ImGui.Text("Distance: " .. dist_str)
	
	ImGui.Separator()
	
	-- Position Information
	ImGui.Text("Position Information:")
	ImGui.Text("Level Vertex ID: " .. tostring(lvid or "N/A"))
	ImGui.Text("Game Vertex ID: " .. tostring(gvid or "N/A"))
	local pos_str = pos and string.format("%.3f, %.3f, %.3f", pos.x, pos.y, pos.z) or "N/A"
	ImGui.Text("Position: " .. pos_str)
	ImGui.Text("Lvid from Position: " .. tostring(lvid_from_pos or "N/A"))
	local pos_from_vertex_str = pos_from_vertex and string.format("%.3f, %.3f, %.3f", pos_from_vertex.x, pos_from_vertex.y, pos_from_vertex.z) or "N/A"
	ImGui.Text("Position from Vertex: " .. pos_from_vertex_str)
	local dir_str = dir and string.format("%.3f, %.3f, %.3f HP (%.3f, %.3f)", 
		dir.x, dir.y, dir.z, dir:getH(), dir:getP()) or "N/A"
	ImGui.Text("Direction: " .. dir_str)
	local angle_str = angle and string.format("%.3f, %.3f, %.3f", angle.x, angle.y, angle.z) or "N/A"
	ImGui.Text("Angle: " .. angle_str)
	ImGui.Text("Position Valid: " .. tostring(valid or false))
end

-- Tool registration
imgui_debug_tools.register_tool("position_target_hud", {
	title = "Position Target",
	render = render,
	visible = false
})
