-- Team Squad Group Debug Tool



local function get_nearest_monster(npc)
	local dist
	local pos = device and device().cam_pos
	local nearest_stalker = npc
	local nearest_dist = npc and pos and pos:distance_to_sqr(npc:position())
	
	if db and db.storage and pos then
		for id, st in pairs(db.storage) do
			local mon = st.object or (level and level.object_by_id and level.object_by_id(id))
			if (mon and IsMonster and IsMonster(mon) and mon:alive()) then
				dist = pos:distance_to_sqr(mon:position())
				if not (nearest_dist) then
					nearest_dist = dist
					nearest_stalker = mon
				end

				if (dist < nearest_dist) then
					nearest_dist = dist
					nearest_stalker = mon
				end
			end
		end
	end
	return nearest_stalker, nearest_dist
end

function render()
	local near = get_nearest_monster(xrs_debug_tools.get_debug_npc and xrs_debug_tools.get_debug_npc())
	local near_name = near and near:name() or "No Monster"
	local near_id = near and near:id() or "N/A"
	
	ImGui.Text("Nearest Monster: " .. near_name .. " (ID: " .. tostring(near_id) .. ")")
	ImGui.Separator()
	
	-- Always display team/squad/group information
	local se_obj, team, squad, group
	if (near) then 
		se_obj = alife_object and alife_object(near:id())
		if (se_obj) then
			team = se_obj.team
			squad = se_obj.squad
			group = se_obj.group
		end
	end
	
	-- Team Squad Group Information
	local name_info = "N/A"
	local team_info = tostring(team or "N/A")
	local squad_info = tostring(squad or "N/A")
	local group_info = tostring(group or "N/A")
	
	if se_obj then
		name_info = string.format("%s [%s]", se_obj:name(), se_obj.id)
	end
	
	ImGui.Text("Team/Squad/Group Information:")
	ImGui.Text("Name: " .. name_info)
	ImGui.Text("Team: " .. team_info)
	ImGui.Text("Squad: " .. squad_info)
	ImGui.Text("Group: " .. group_info)
	
	ImGui.Separator()
	
	-- Smart Terrain NPC Info
	local smart_npc_info = {}
	local smart_arriving_npc = {}
	local smart_name = "No Smart Terrain"
	
	if (smart_terrain and smart_terrain.nearest_to_actor_smart and smart_terrain.nearest_to_actor_smart.id) then
		local smart = alife_object and alife_object(smart_terrain.nearest_to_actor_smart.id)
		if (smart) then
			smart_name = smart:name()
			-- Collect NPC info
			if smart.npc_info then
				for id, v in pairs(smart.npc_info) do
					if (v.se_obj) then
						table.insert(smart_npc_info, {id = id, name = v.se_obj:name()})
					end
				end
			end
			-- Collect arriving NPC info
			if smart.arriving_npc then
				for id, se_obj in pairs(smart.arriving_npc) do
					if (se_obj) then
						local distance = se_obj.position and smart.position and 
							se_obj.position:distance_to(smart.position) or 0
						table.insert(smart_arriving_npc, {
							id = id, 
							name = se_obj:name(), 
							distance = distance
						})
					end
				end
			end
		end
	end
	
	ImGui.Text("Nearest Smart Terrain: " .. smart_name)
	ImGui.Separator()
	
	-- NPC Info Table
	ImGui.Text("NPCs in Smart Terrain:")
	if ImGui.BeginTable("SmartNPCInfo", 2, 3, vector2(0, 0), 0) then
		ImGui.TableSetupColumn("NPC ID")
		ImGui.TableSetupColumn("NPC Name")
		ImGui.TableHeadersRow()
		
		for _, npc_data in ipairs(smart_npc_info) do
			ImGui.TableNextRow()
			ImGui.TableSetColumnIndex(0)
			ImGui.Text(tostring(npc_data.id))
			ImGui.TableSetColumnIndex(1)
			ImGui.Text(npc_data.name)
		end

		ImGui.EndTable()
	end
	
	ImGui.Separator()
	
	-- Arriving NPC Table
	ImGui.Text("Arriving NPCs:")
	if ImGui.BeginTable("ArrivingNPCs", 3, 3, vector2(0, 0), 0) then
		ImGui.TableSetupColumn("NPC ID")
		ImGui.TableSetupColumn("NPC Name")
		ImGui.TableSetupColumn("Distance (m)")
		ImGui.TableHeadersRow()
		
		for _, npc_data in ipairs(smart_arriving_npc) do
			ImGui.TableNextRow()
			ImGui.TableSetColumnIndex(0)
			ImGui.Text(tostring(npc_data.id))
			ImGui.TableSetColumnIndex(1)
			ImGui.Text(npc_data.name)
			ImGui.TableSetColumnIndex(2)
			ImGui.Text(string.format("%.1f", npc_data.distance))
		end
		
		ImGui.EndTable()
	end
end

-- Tool registration
imgui_debug_tools.register_tool("team_squad_group_hud", {
	title = "Team Squad Group",
	render = render,
	visible = false
})
