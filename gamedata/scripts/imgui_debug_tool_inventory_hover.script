-- Inventory Hover Debug Tool
function render()
	local itm = xrs_debug_tools.hover_item_id and level and level.object_by_id and level.object_by_id(xrs_debug_tools.hover_item_id)
	local item_name = itm and itm:name() or "No Item"
	local item_id = xrs_debug_tools.hover_item_id or "N/A"
	
	ImGui.Text("Hovered Item: " .. item_name .. " (ID: " .. tostring(item_id) .. ")")
	ImGui.Separator()
	
	-- Always display item information, even if no item is hovered
	local section, condition, cost, cost_condition
	
	if itm then
		section = itm:section()
		condition = itm:condition()
		cost = ini_sys and ini_sys.r_float_ex and ini_sys:r_float_ex(section, "cost")
		cost_condition = condition and cost and (condition * cost)
	end
	
	-- Item Information
	ImGui.Text("Item Information:")
	ImGui.Text("Name: " .. item_name)
	ImGui.Text("Section: " .. tostring(section or "N/A"))
	local condition_str = condition and string.format("%.3f", condition) or "N/A"
	ImGui.Text("Condition: " .. condition_str)
	local cost_str = cost and string.format("%.2f", cost) or "N/A"
	ImGui.Text("Base Cost: " .. cost_str)
	local cost_condition_str = cost_condition and string.format("%.2f", cost_condition) or "N/A"
	ImGui.Text("Cost * Condition: " .. cost_condition_str)
end

-- Tool registration
imgui_debug_tools.register_tool("inventory_hover_hud", {
	title = "Inventory Hover",
	render = render,
	visible = false
})
