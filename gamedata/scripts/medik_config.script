}

local FIELDS = {
    { "model_pos", true },
    { "model_rot", true },
    { "model_scale", false },
    { "ui_pos", true },
    { "ui_rot", true },
    { "ui_scale", false },
    { "hand_pos", true },
    { "skin", false },
    { "theme", false },
    { "emblem", false },
    { "hud_psy", false },
    { "hud_fire", false },
    { "hud_status", false },
    { "hud_companions", false },
    { "hud_rad", false },
}

transforms = {}
saved = {}

local function copy_fields(src)
    local out = {}
    for _, f in ipairs(FIELDS) do
        local name, is_vec3 = f[1], f[2]
        local v = src[name]
        out[name] = is_vec3 and { v[1], v[2], v[3] } or v
    end
    return out
end

function reset_transforms()
    transforms = copy_fields(TRANSFORM_DEFAULTS)
end

function snapshot_saved()
    saved = copy_fields(transforms)
end

reset_transforms()
snapshot_saved()

local function ltx_path()
    if not getFS then
        return nil
    end
    return getFS():update_path("$game_config$", "") .. "medik_reposition_gui.ltx"
end

local function welcome_path()
    if not getFS then
        return nil
    end
    return getFS():update_path("$game_config$", "") .. "medik_welcomed.flag"
end

function is_welcomed()
    local p = welcome_path()
    if not p then
        return true
    end
    local f = io.open(p, "r")
    if f then
        f:close()
        return true
    end
    return false
end

function mark_welcomed()
    local p = welcome_path()
    if not p then
        return
    end
    local f = io.open(p, "w")
    if f then
        f:write("1")
        f:close()
    end
end

function load_transforms()
    local path = ltx_path()
    if not path then
        return
    end
    local f = io.open(path, "r")
    if not f then
        return
    end
    local vals = {}
    for line in f:lines() do
        if not line:match("^%s*%[") then
            local k, v = line:match("^%s*([%w_]+)%s*=%s*(.-)%s*$")
            if k and v then
                vals[k] = v
            end
        end
    end
    f:close()
    for _, fd in ipairs(FIELDS) do
        local name, is_vec3 = fd[1], fd[2]
        local s = vals[name]
        if s and is_vec3 then
            local a, b, c = s:match("^%s*([^,]+),%s*([^,]+),%s*([^,]+)%s*$")
            local x, y, z = tonumber(a), tonumber(b), tonumber(c)
            if x and y and z then
                transforms[name] = { x, y, z }
            end
        elseif s then
            transforms[name] = tonumber(s) or s
        end
    end
    snapshot_saved()
end

function save_transforms()
    local path = ltx_path()
    if not path then
        return false
    end
    local f = io.open(path, "w")
    if not f then
        return false
    end
    f:write("[medik_reposition_gui]\n")
    for _, fd in ipairs(FIELDS) do
        local name, is_vec3 = fd[1], fd[2]
        local v = transforms[name]
        if is_vec3 then
            f:write(string.format("%s = %s,%s,%s\n", name, v[1], v[2], v[3]))
        else
            f:write(string.format("%s = %s\n", name, v))
        end
    end
    f:close()
    snapshot_saved()
    return true
end

function skin_index()
    local n = math.floor((tonumber(transforms.skin) or 1) + 0.5)
    if n < 1 then
        n = 1
    elseif n > #SKINS then
        n = #SKINS
    end
    return n
end

function skin_model()
    return SKINS[skin_index()].model
end

function hand_section()
    local t = transforms.hand_pos
    local function idx(v)
        local n = math.floor(v / HAND_STEP + 0.5) + 8
        if n < 0 then
            n = 0
        elseif n > 16 then
            n = 16
        end
        return n
    end
    local ix, iy, iz = idx(t[1]), idx(t[2]), idx(t[3])
    if ix == 8 and iy == 8 and iz == 8 then
        return "anim_medik_hud"
    end
    return string.format("anim_medik_hud_%d_%d_%d", ix, iy, iz)
end
