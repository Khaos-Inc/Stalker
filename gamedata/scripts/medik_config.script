function register_theme(theme)
    if type(theme) ~= "table" then
        return false
    end
    local name = theme.name
    if type(name) ~= "string" or name == "" then
        return false
    end
    for _, existing in ipairs(THEMES) do
        if existing.name == name then
            return false
        end
    end
    THEMES[#THEMES + 1] = {
        name = name,
        label = theme.label or name,
        prefix = theme.prefix or (name .. "_"),
        fac = nil,
    }
    return true
end

function theme_index()
    local want = transforms.theme
    for i, t in ipairs(THEMES) do
        if t.name == want then
            return i
        end
    end
    return 1
end

function theme_prefix()
    return THEMES[theme_index()].prefix
end

function theme_faction()
    return THEMES[theme_index()].fac
end

