tools = {}
local feature_active = false
local expected_feature_is_enabled = false

-- Function to register a tool
function imgui_debug_tools.register_tool(name, tool_config)
    tools[name] = tool_config
end

local old_xrs_debug_tools_activate_feature = xrs_debug_tools.activate_feature
function xrs_debug_tools.activate_feature()
    expected_feature_is_enabled = true
    old_xrs_debug_tools_activate_feature()
end

local old_xrs_debug_tools_deactivate_feature = xrs_debug_tools.deactivate_feature
function xrs_debug_tools.deactivate_feature()
    old_xrs_debug_tools_deactivate_feature()
    expected_feature_is_enabled = false
end

-- Function to check if any tools are visible and manage feature state
local function update_feature_state()
    local any_visible = false
    for _, tool in pairs(tools) do
        if tool.visible then
            any_visible = true
            break
        end
    end
    
    if any_visible and not feature_active then
        old_xrs_debug_tools_activate_feature()
        feature_active = true
    elseif not any_visible and feature_active and not expected_feature_is_enabled then
        old_xrs_debug_tools_deactivate_feature()
        feature_active = false
    end
end

function on_game_start()
    local sorted_tools = {}
    for tool_name, tool in pairs(tools) do
        table.insert(sorted_tools, {name = tool_name, config = tool})
    end
    table.sort(sorted_tools, function(a, b) return a.config.title < b.config.title end)
    
    ImGui.Groups.Debug.Widget(function()
        if ImGui.BeginMenu("Tools", true) then
            local visibility_changed = false
            for _, tool_data in ipairs(sorted_tools) do
                local tool = tool_data.config
                local old_visible = tool.visible
                local _
                _, tool.visible = ImGui.MenuItem(tool.title, nil, tool.visible, true)
                if old_visible ~= tool.visible then
                    visibility_changed = true
                end
            end
            if visibility_changed then
                update_feature_state()
            end
            ImGui.EndMenu()
        end
    end)

    ImGui.Groups.Unique.Widget(function()
        local visibility_changed = false
        for _, tool_data in ipairs(sorted_tools) do
            local tool_name = tool_data.name
            local tool = tool_data.config
            if tool.visible then
                local old_visible = tool.visible
                local expanded, visible = ImGui.Begin(tool.title, tool.visible, 0)
                tool.visible = visible
                if old_visible ~= tool.visible then
                    visibility_changed = true
                end
                if expanded then
                    local ok, err = pcall(tool.render)
                    if not ok then
                        ImGui.Text("render error: " .. tostring(err))
                    end
                    SendScriptCallback("imgui_on_render", tool_name)
                end
                ImGui.End()
            end
        end
        if visibility_changed then
            update_feature_state()
        end
    end)

    -- Initial feature state check
    update_feature_state()
end



