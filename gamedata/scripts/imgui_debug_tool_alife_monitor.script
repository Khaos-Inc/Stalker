-- Register this tool
imgui_debug_tools.register_tool("AlifeMonitor", {
    title = "Alife Monitor",
    render = function()
        render_alife_monitor_hud()
    end,
    visible = false
})

local tg_am = 0
function render_alife_monitor_hud()
    if (tg_am < time_global()) then
        tg_am = time_global() + 60000
        alife_first_update()
    end
    
    ImGui.Text("Server objects count: " .. tostring(_ALIFE_CNT or 0))
    ImGui.Separator()
    ImGui.Text("Listed: " .. tostring(_ALIFE_CACHE and #_ALIFE_CACHE or 0))
    ImGui.Separator()
    
    if not _ALIFE_CACHE then
        ImGui.Text("No alife cache available")
        return
    end
    
    local table_flags = 3 -- Borders(1) + RowBg(2)
    if ImGui.BeginTable("AlifeTable", 2, table_flags, vector2(0, 0), 0) then
        ImGui.TableSetupColumn("Status", 2, 0, 0)
        ImGui.TableSetupColumn("Object", 2, 0, 0)
        ImGui.TableHeadersRow()
        
        for i=1,25 do
            if _ALIFE_CACHE[i] then
                local str = string.sub(_ALIFE_CACHE[i],1,1)
                local status = str == "+" and "[+]" or "[-]"
                local obj_name = string.sub(_ALIFE_CACHE[i],2)
                
                ImGui.TableNextRow()
                
                ImGui.TableNextColumn()
                ImGui.Text(status)
                
                ImGui.TableNextColumn()
                ImGui.Text(obj_name)
            end
        end
        
        ImGui.EndTable()
    end
end