--[[
	=====================================================================
	Addon      : Mark Switch
	Link       : https://www.moddb.com/mods/stalker-anomaly/addons/mark-switch
	Author     : party_50
	Date       : 10.02.2024
	Last Edit  : 16.09.2024
	=====================================================================
--]]


local KEYBIND
local SOUND
local ALL_PARAMETERS = {
	ms_count = "float",
	ms_colors = "ms_color"
}

local current_marks = {}
local last_weapon_id
local last_scope


local inventory_upgrade_base = ui_inventory.UIInventory.RMode_UpgradeYes
local workshop_upgrade_base = ui_workshop.UIWorkshopUpgrade.Upgrade

function ui_inventory.UIInventory:RMode_UpgradeYes()
	inventory_upgrade_base(self)
	last_weapon_id = nil
	last_scope = nil
end

function ui_workshop.UIWorkshopUpgrade:Upgrade()
	workshop_upgrade_base(self)
	last_weapon_id = nil
	last_scope = nil
end


function init()	
	SOUND = sound_object('interface\\mark_adjust')
end

function on_option_change()
	local configured = z_mark_switch_mcm.get_config("keybind")
	KEYBIND = configured or DIK_keys.DIK_EQUALS
end

function get_mark_count(section)
	return ini_sys:r_float_ex(section, "ms_count")
end

function get_mark_color(section, i)
	local colors = parse_list(ini_sys, section, "ms_colors")
	if not colors or #colors == 0 then
		return nil
	end
	
	if i >= #colors then
		i = #colors - 1
	end

	local requested = colors[i + 1]
	local resolved = requested
	local color = ini_sys:r_string_ex("markswitch_colors", resolved)

	-- Desolation/S3DS color packs commonly use scope_* names while configs
	-- often use the shorter black/red/green names. Accept both forms.
	if not color and requested and not string.find(requested, "^scope_") then
		resolved = "scope_" .. requested
		color = ini_sys:r_string_ex("markswitch_colors", resolved)
	end

	-- Diagnostic builds must never CTD because of a typo/missing palette entry.
	if not color then
			return "0, 0, 0, 0"
	end

	return color
end

function get_sight_section(wpn)
	local wpn_section = wpn:section()

	local modular_attachments = ini_sys:r_bool_ex(wpn_section, "modular_attachments", false)
	if modular_attachments then
		local c_wpn = wpn:cast_Weapon()
		-- Active inventory items can inherit modular_attachments without being
		-- weapons. Never call weapon attachment methods unless the cast worked.
		if not c_wpn then
			return nil
		end
		local attached = c_wpn['IsScopeAttached'](c_wpn)
		if attached then
			local scope = c_wpn['GetScopeName'](c_wpn)
			return scope
		end
		return nil
	end

	local parent = ini_sys:r_string_ex(wpn_section, "parent_section") or wpn_section
	if #parent == #wpn_section then
		return wpn_section
	end

	return wpn_section:sub(#parent + 2)
end

function parse_key(section, key, type, current_mark)
	if key == "ms_count" then
		return get_mark_count(section)
	elseif key == "ms_colors" then
		return get_mark_color(section, current_mark)
	end
end

local function resolve_parameter(wpn, key, type, current_mark)
	local value

	-- Preserve upgrade priority, but do not let an upgrade that does not
	-- define this key erase a value from an earlier upgrade.
	wpn:iterate_installed_upgrades(
		function(upgr_sec)
			local upgrade_value = parse_key(upgr_sec, key, type, current_mark)
			if upgrade_value ~= nil then
				value = upgrade_value
			end
		end
	)
	if value ~= nil then
		return value
	end

	local wpn_section = wpn:section()
	local sight_section = get_sight_section(wpn)
	local modular_attachments = ini_sys:r_bool_ex(wpn_section, "modular_attachments", false)

	-- Modular Desolation weapons take mark-switch data from the actually
	-- installed scope first. Legacy/non-modular weapons retain the original
	-- weapon-section-first fallback order.
	if modular_attachments and sight_section then
		value = parse_key(sight_section, key, type, current_mark)
	end
	if value == nil then
		value = parse_key(wpn_section, key, type, current_mark)
	end
	if value == nil and not modular_attachments and sight_section then
		value = parse_key(sight_section, key, type, current_mark)
	end

	return value
end

function parse_parameters(wpn)
	local values = {}
	local weapon_id = wpn:id()
	local current_mark = current_marks[weapon_id] or 0

	-- Resolve the count first so a remembered mark from a previously attached
	-- scope can be clamped to the new scope before its color is selected.
	local count = tonumber(resolve_parameter(wpn, "ms_count", "float", current_mark)) or 1
	count = math.max(1, math.floor(count + 0.5))
	current_mark = current_mark % count
	current_marks[weapon_id] = current_mark

	values["ms_current"] = current_mark
	values["ms_count"] = count
	values["ms_colors"] = resolve_parameter(wpn, "ms_colors", "ms_color", current_mark)

	return values
end

function get(info, key, default)
	if info[key] then
		return info[key]
	end
	return default
end

function update_shader(wpn, info)
	get_console():execute("markswitch_current " .. get(info, "ms_current", 0))
	get_console():execute("markswitch_count " .. get(info, "ms_count", 1))
	get_console():execute("markswitch_color " .. get(info, "ms_colors", "0, 0, 0, 0"))
end

function apply_next_mark(wpn, info)
	SOUND:play(db.actor, 0, sound_object.s2d)
	game.play_hud_anm("script\\mark_adjust.anm", 2, 2, 1, false, false)
	
	local old_mark = get(info, "ms_current", 0)
	local mark = (old_mark + 1) % get(info, "ms_count", 1)
	current_marks[wpn:id()] = mark
	
	info = parse_parameters(wpn)	 
	update_shader(wpn, info)
end

function on_key_release(key)
	if key ~= KEYBIND then
		return
	end

	if not (db.actor and db.actor:alive()) then
		return
	end

	local wpn = db.actor:active_item()
	if not wpn then
		return
	end

	local c_wpn = wpn:cast_Weapon()
	if not c_wpn then
		return
	end

	local scope = get_sight_section(wpn)
	local info = parse_parameters(wpn)
	if get(info, "ms_count", 1) < 2 then
		return
	end

	apply_next_mark(wpn, info)
end

function actor_on_update()
	if not (db.actor and db.actor:alive()) then
		return
	end
	
	local wpn = db.actor:active_item()
	if not wpn then
		last_weapon_id = nil
		last_scope = nil
		return
	end

	local c_wpn = wpn:cast_Weapon()
	if not c_wpn then
		last_weapon_id = nil
		last_scope = nil
		return
	end

	local scope = get_sight_section(wpn)
	if not last_weapon_id or last_weapon_id ~= wpn:id() or last_scope ~= scope then
		last_weapon_id = wpn:id()
		last_scope = scope
		local info = parse_parameters(wpn)
		update_shader(wpn, info)
	end
end

function server_entity_on_unregister(obj)
	if current_marks[obj.id] then
		current_marks[obj.id] = nil
	end
end

function save_state(m_data)
	m_data.mark_switch_current_marks = current_marks
end

function load_state(m_data)
	current_marks = type(m_data.mark_switch_current_marks) == "table" and m_data.mark_switch_current_marks or {}
end

function on_game_start()
	init()
	on_option_change()
	RegisterScriptCallback("on_option_change", on_option_change)
	RegisterScriptCallback("on_key_release", on_key_release)
	RegisterScriptCallback("actor_on_update", actor_on_update)
	RegisterScriptCallback("server_entity_on_unregister", server_entity_on_unregister)
	RegisterScriptCallback("save_state", save_state)
	RegisterScriptCallback("load_state", load_state)
end
