-- Behavior Debug Tool



function render()
	local near = xrs_debug_tools.get_debug_npc and xrs_debug_tools.get_debug_npc()
	local near_name = near and near:name() or "No NPC"
	local near_id = near and near:id() or "N/A"
	
	ImGui.Text("Debug NPC: " .. near_name .. " (ID: " .. tostring(near_id) .. ")")
	ImGui.Separator()
	
	-- Always display behavior information
	local has_npc = near and near:alive()
	local full_st = has_npc and db and db.storage and db.storage[near:id()]
	local beh_st = full_st and full_st.beh
	
	-- Behavior Information
	ImGui.Text("Behavior Information:")
	-- Target information
	local target_name = beh_st and beh_st.desired_target and beh_st.desired_target.object and 
		beh_st.desired_target.object:name() or "None"
	ImGui.Text("Target: " .. tostring(target_name))
	local target_type = beh_st and beh_st.target or "None"
	ImGui.Text("Target Type: " .. tostring(target_type))
	local lvid = beh_st and beh_st.desired_target and beh_st.desired_target.level_vertex_id or "N/A"
	ImGui.Text("Desired Level Vertex ID: " .. tostring(lvid))
	local pos_str = "N/A"
	if beh_st and beh_st.desired_target and beh_st.desired_target.position and vec_to_str then
		pos_str = vec_to_str(beh_st.desired_target.position)
	end
	ImGui.Text("Position: " .. tostring(pos_str))
	local behavior = beh_st and beh_st.behavior or "None"
	ImGui.Text("Behavior: " .. tostring(behavior))
	local assist_pt = beh_st and beh_st.assist_point or "None"
	ImGui.Text("Assist Point: " .. tostring(assist_pt))
	local last_state = beh_st and beh_st.last_state or "None"
	ImGui.Text("Last State: " .. tostring(last_state))
	
	ImGui.Separator()
	
	-- Path Information
	ImGui.Text("Path Information:")
	local path_index = full_st and full_st.beh and full_st.beh.path_index or "N/A"
	ImGui.Text("Path Index: " .. tostring(path_index))
	local wait_timer = "N/A"
	if full_st and full_st.beh and full_st.beh.wait_delay and time_global then
		wait_timer = tostring(full_st.beh.wait_delay - time_global())
	end
	ImGui.Text("Path Wait Timer: " .. wait_timer)
	local path_reached = full_st and full_st.beh and full_st.beh.am_i_reached == true or false
	ImGui.Text("Path Reached: " .. tostring(path_reached))
	
	ImGui.Separator()
	
	-- Activity Information
	ImGui.Text("Activity Information:")
	local gather_items = "None"
	if full_st and full_st.gather_items and full_st.gather_items.gather_items_enabled and 
		xr_logic and xr_logic.pick_section_from_condlist and db and db.actor then
		gather_items = xr_logic.pick_section_from_condlist(db.actor, near, full_st.gather_items.gather_items_enabled) or "None"
	end
	ImGui.Text("Gather Items: " .. tostring(gather_items))
	local loot_corpses = "None"
	if full_st and full_st.corpse_detection and full_st.corpse_detection.corpse_detection_enabled and 
		xr_logic and xr_logic.pick_section_from_condlist and db and db.actor then
		loot_corpses = xr_logic.pick_section_from_condlist(db.actor, near, full_st.corpse_detection.corpse_detection_enabled) or "None"
	end
	ImGui.Text("Loot Corpses: " .. tostring(loot_corpses))
end

-- Tool registration
imgui_debug_tools.register_tool("behavior_hud", {
	title = "Behavior Info",
	render = render,
	visible = false
})
