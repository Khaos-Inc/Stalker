--------------------------------------------------------------------------------
-- interaction
--------------------------------------------------------------------------------
function toggle_hideout_cat(obj_id)
    local obj = level.object_by_id(obj_id)
    if not obj then return end

    local binder = obj:binded_object()
    if not binder or not binder.wrapper then return end

    local w = binder.wrapper
    if w and w.on_interact then
        w:on_interact()
    end
end

--------------------------------------------------------------------------------
-- init
--------------------------------------------------------------------------------
function init(obj)
    obj:bind_object(hideout_cat_wrapper(obj).binder)
end

--------------------------------------------------------------------------------
-- helper
--------------------------------------------------------------------------------

local PURR_VOLUME_MAX  = 0.3
local PURR_FADE_IN     = 7.5
local PURR_FADE_OUT    = 5.0

local FUR_COLOR
local FUR_HIDDEN

function on_option_change()
	if (ui_mcm) then
		FUR_COLOR = ui_mcm.get("hideout_cat_settings/hideout_cat_color")
		FUR_HIDDEN = ui_mcm.get("hideout_cat_settings/hideout_cat_fur_hidden")
		printf("[CAT] Settings changed")
	end
end

RegisterScriptCallback("on_option_change",on_option_change)
RegisterScriptCallback("actor_on_first_update", on_option_change)

local function norm_dt(delta)
    local dt = delta
    if dt > 1.0 then dt = dt / 1000.0 end
    if dt > 0.25 then dt = 0.25 end
    return dt
end

-- clip lengths
local ANIM_LEN = {
    -- idles (standing)
    idle_1 = 2.6, idle_2 = 4.7, idle_3 = 3.366, idle_4 = 5.266, idle_7 = 3.6,

    -- sit
    sit_start = 0.866, sit_end = 1.0,
    sit_loop_1 = 2.6, sit_loop_2 = 5.533, sit_loop_3 = 4.266,

    -- lie belly
    lie_belly_start = 0.833, lie_belly_end = 0.833,
    lie_belly_loop_1 = 2.6, lie_belly_loop_2 = 4.7, lie_belly_loop_3 = 3.366,
    lie_belly_sleep_start = 0.7, lie_belly_sleep = 1.366, lie_belly_sleep_end = 0.7,

    -- lie side
    lie_side_start = 0.966, lie_side_end = 1.2,
    lie_side_loop_1 = 2.6, lie_side_loop_2 = 6.033,
    lie_side_sleep_start = 0.866, lie_side_sleep = 1.366, lie_side_sleep_end = 1.366,

    -- misc one-shots
    lick = 5.533,
    scratching = 4.2,

    -- transitions
    trans_liebelly_sit = 1.033,
    trans_lieside_sit  = 1.2,
    trans_sit_liebelly = 0.866,
    trans_sit_lieside  = 1,
}

local function anim_len(name)
    return ANIM_LEN[name] or 1.5
end

local function rand_range(a, b)
    return random_float(a, b)
end

-- weighted choice
local function weighted_pick(list)
    local sum = 0
    for i = 1, #list do sum = sum + (list[i].w or 0) end
    if sum <= 0 then return nil end

    local r = math.random(sum) -- 1..sum
    local acc = 0
    for i = 1, #list do
        acc = acc + (list[i].w or 0)
        if r <= acc then return list[i].name end
    end
    return list[#list].name
end

--------------------------------------------------------------------------------
-- behavior tuning
--------------------------------------------------------------------------------
local CAT_BEHAVIOR = {
    state_weights = {
        { name="idle",        w=5, min=15, max=45 },
        { name="sit",         w=10, min=10, max=45 },
        { name="lie_belly",   w=15, min=30, max=80 },
        { name="lie_side",    w=20, min=30, max=80 },
        { name="sleep_belly", w=25, min=60, max=180 },
        { name="sleep_side",  w=25, min=60, max=180 },
    },

    loop_weights = {
        idle = {
            { name="idle_1", w=82 }, { name="idle_2", w=5 }, { name="idle_3", w=5 },
            { name="idle_4", w=2 }, { name="idle_7", w=2 },{ name="lick", w=2 },{ name="scratching", w=2 },
        },
        sit = {
            { name="sit_loop_1", w=93 }, { name="sit_loop_2", w=5 }, { name="sit_loop_3", w=2 },
        },
        lie_belly = {
            { name="lie_belly_loop_1", w=90 }, { name="lie_belly_loop_2", w=5 }, { name="lie_belly_loop_3", w=5 },
        },
        lie_side = {
            { name="lie_side_loop_1", w=98 }, { name="lie_side_loop_2", w=2 },
        },
        sleep_belly = {
            { name="lie_belly_sleep", w=100 },
        },
        sleep_side = {
            { name="lie_side_sleep", w=100 },
        },
    },
}

--------------------------------------------------------------------------------
-- motion mapping
--------------------------------------------------------------------------------
local STATE = {
    idle = { loops_key="idle" },

    sit = { start="sit_start", ["end"]="sit_end", loops_key="sit" },

    lie_belly = { start="lie_belly_start", ["end"]="lie_belly_end", loops_key="lie_belly" },

    lie_side = { start="lie_side_start", ["end"]="lie_side_end", loops_key="lie_side" },

    sleep_belly = { start="lie_belly_sleep_start", ["end"]="lie_belly_sleep_end", loops_key="sleep_belly" },

    sleep_side = { start="lie_side_sleep_start", ["end"]="lie_side_sleep_end", loops_key="sleep_side" },
}

-- transitions between postures
local TRANS = {
    ["lie_belly->sit"] = "trans_liebelly_sit",
    ["lie_side->sit"]  = "trans_lieside_sit",
    ["sit->lie_belly"] = "trans_sit_liebelly",
    ["sit->lie_side"]  = "trans_sit_lieside",
}

local function is_sleep_state(s)
    return s == "sleep_belly" or s == "sleep_side"
end

--------------------------------------------------------------------------------
-- class "hideout_cat_wrapper"
--------------------------------------------------------------------------------
class "hideout_cat_wrapper" (bind_hf_base.hf_binder_wrapper)

function hideout_cat_wrapper:__init(obj)
    super(obj)

    -- sounds
    self.snd_purr    = sound_object([[hideout_cat_sounds\cat_purr]])
    self.snd_miau_1  = sound_object([[hideout_cat_sounds\cat_miau_1]])
    self.snd_miau_2  = sound_object([[hideout_cat_sounds\cat_miau_2]])
    self.snd_miau_3  = sound_object([[hideout_cat_sounds\cat_miau_3]])
    self.snd_miau_4  = sound_object([[hideout_cat_sounds\cat_miau_4]])
    self.snd_miau_5  = sound_object([[hideout_cat_sounds\cat_miau_5]])
	self.snd_pickup = sound_object([[hideout_cat_sounds\cat_pickup]])
	
	self.current_fur_color = 0
	self.new_fur_color = ui_mcm.get("hideout_cat_settings/hideout_cat_color")
	self.current_fur_hidden = 0
	self.new_fur_hidden = ui_mcm.get("hideout_cat_settings/hideout_cat_fur_hidden")

    -- animation state machine
    self.anim = {
		state   = "idle",
		target  = nil,
		phase   = "loop",
		lock    = 0.0,
		pending = nil,
		current = nil,
		force_loop = nil,

		loop_name   = nil,
		loop_timer  = 0.0,
		loop_time   = 0.0,   
		loop_events = {},    
	}

    -- behavior
    self.ai = {
		state_timer = 0.0,
		chain = nil,
		chain_i = 1,

		next_state = nil,
		next_force_loop = false, 
	}
	
	self.purr = {
		volume = 0.0,
		target = 0.0,
	}

    self:_enter_state("idle", true)
end

--------------------------------------------------------------------------------
-- animation play wrappers
--------------------------------------------------------------------------------
function hideout_cat_wrapper:_set_loop(loop_name)
    self.anim.loop_name  = loop_name
    self.anim.loop_timer = anim_len(loop_name)

    -- reset per-loop timing
    self.anim.loop_time   = 0.0
    self.anim.loop_events = {}
end

function hideout_cat_wrapper:_anim_play_cycle(name)
    if not self.object then return end
    self.object:play_cycle(name)
    self.anim.lock = math.max(self.anim.lock, 0.12)
    self.anim.current = name
end

function hideout_cat_wrapper:_anim_play_fx(name)
    if not self.object then return end

    if self.object.play_fx then
        self.object:play_fx(name)
    else
        self.object:play_cycle(name)
    end

    self.anim.lock = math.max(self.anim.lock, anim_len(name))
    self.anim.current = name
end

--------------------------------------------------------------------------------
-- weighted selection
--------------------------------------------------------------------------------
function hideout_cat_wrapper:_pick_next_state()
    local pick_name = weighted_pick(CAT_BEHAVIOR.state_weights)
    if not pick_name then return "idle", 20 end

    for i = 1, #CAT_BEHAVIOR.state_weights do
        local e = CAT_BEHAVIOR.state_weights[i]
        if e.name == pick_name then
            return pick_name, rand_range(e.min or 10, e.max or 30)
        end
    end

    return "idle", 20
end

function hideout_cat_wrapper:_pick_loop_for_state(state_name)
    local def = STATE[state_name]
    if not def then return nil end
    local key = def.loops_key
    local list = CAT_BEHAVIOR.loop_weights[key]
    if not list then return nil end
    return weighted_pick(list)
end

--------------------------------------------------------------------------------
-- enter state (internal)
--------------------------------------------------------------------------------
function hideout_cat_wrapper:_enter_state(new_state, immediate)
    local def = STATE[new_state]
    if not def then return end

    self.anim.state   = new_state
    self.anim.target  = nil
    self.anim.pending = nil

    -- set duration for this state
    local dur = 20
    for i = 1, #CAT_BEHAVIOR.state_weights do
        local e = CAT_BEHAVIOR.state_weights[i]
        if e.name == new_state then
            dur = rand_range(e.min or 10, e.max or 30)
            break
        end
    end
    self.ai.state_timer = dur

    if immediate then
        local loop = self:_pick_loop_for_state(new_state)
        if loop then
            self.anim.phase = "loop"
            self:_anim_play_cycle(loop)
            self:_set_loop(loop)
        end
        return
    end

    if def.start then
        self.anim.phase = "start"
        self:_anim_play_fx(def.start)
    else
		local loop
		if self.anim.force_loop then
			loop = self.anim.force_loop
			self.anim.force_loop = nil
		else
			loop = self:_pick_loop_for_state(new_state)
		end

		if loop then
			self.anim.phase = "loop"
			self:_anim_play_cycle(loop)
			self:_set_loop(loop)
		end
	end
end

function hideout_cat_wrapper:_apply_next_state_if_ready()
    if not self.ai.next_state then return end

    -- only apply when not locked and not mid-transition/end/start
    if self.anim.lock > 0 then return end
    if self.anim.phase ~= "loop" then return end

    local s = self.ai.next_state
    local force_loop = self.ai.next_force_loop

    self.ai.next_state = nil
    self.ai.next_force_loop = false

    -- if the next state is the same re-pick
    if s == self.anim.state then
        if force_loop then
            local loop = self:_pick_loop_for_state(self.anim.state)
            if loop then
                self.anim.phase = "loop"
                self:_anim_play_cycle(loop)
                self:_set_loop(loop)
            end
        end
        return
    end

    -- different state: do a normal request
    self:request_state(s)
end

--------------------------------------------------------------------------------
-- sleep routing helper
--------------------------------------------------------------------------------
function hideout_cat_wrapper:_route_sleep(target_sleep)
    -- build a chain that first goes to the right lying posture
    if target_sleep == "sleep_side" then
        self.ai.chain = {"lie_side", "sleep_side"}
    else
        self.ai.chain = {"lie_belly", "sleep_belly"}
    end
    self.ai.chain_i = 1

    self:request_state(self.ai.chain[self.ai.chain_i])
end

function hideout_cat_wrapper:_advance_chain_if_needed()
    if not self.ai.chain then return end
    if self.ai.chain_i >= #self.ai.chain then
        self.ai.chain = nil
        return
    end

    -- if reached the current state, advance to next
    local cur_target = self.ai.chain[self.ai.chain_i]
    if self.anim.state == cur_target and self.anim.phase == "loop" and self.anim.lock <= 0 then
        self.ai.chain_i = self.ai.chain_i + 1
        self:request_state(self.ai.chain[self.ai.chain_i])
    end
end

--------------------------------------------------------------------------------
-- safe state switching
--------------------------------------------------------------------------------
function hideout_cat_wrapper:request_state(new_state)
    if not STATE[new_state] then return end

    -- if asked for sleep route it
    if new_state == "sleep_side" and self.anim.state ~= "lie_side" then
        self:_route_sleep("sleep_side")
        return
    end
    if new_state == "sleep_belly" and self.anim.state ~= "lie_belly" then
        self:_route_sleep("sleep_belly")
        return
    end

    if self.anim.target == new_state then return end
    if self.anim.target == nil and self.anim.state == new_state then return end

    if self.anim.lock > 0 then
        if self.anim.pending ~= new_state then
            self.anim.pending = new_state
        end
        return
    end

    if self.anim.phase == "trans" and self.anim.target ~= nil then
        self.anim.pending = new_state
        return
    end

	local old = self.anim.state

	-- transitions for awake
	local trans = TRANS[old .. "->" .. new_state]
	if trans and (not is_sleep_state(old)) and (not is_sleep_state(new_state)) then
		self.anim.target = new_state
		self.anim.phase  = "trans"
		self:_anim_play_fx(trans)
		return
	end

	-- lie_ -> sleep_ should not play lie_end
	if (old == "lie_side"  and new_state == "sleep_side") or
	   (old == "lie_belly" and new_state == "sleep_belly") then
		self:_enter_state(new_state, false) -- plays sleep_start then loop
		return
	end

	local old_def = STATE[old]
	local new_def = STATE[new_state]

    if old_def and old_def["end"] then
        self.anim.pending = new_state
        self.anim.phase = "end"
        self:_anim_play_fx(old_def["end"])
        return
    end

    if new_def and new_def.start then
        self:_enter_state(new_state, false)
        return
    end

    self:_enter_state(new_state, true)
end

--------------------------------------------------------------------------------
-- interaction
--------------------------------------------------------------------------------
function hideout_cat_wrapper:_play_random_miau()
    local pos = self.object:position()
    local r = math.random(1, 5)
    if r == 1 then
        self.snd_miau_1:play_no_feedback(self.object, sound_object.s3d, 0, pos, 1, random_float(0.9, 1.1))
    elseif r == 2 then
        self.snd_miau_2:play_no_feedback(self.object, sound_object.s3d, 0, pos, 1, random_float(0.9, 1.1))
    elseif r == 3 then
        self.snd_miau_3:play_no_feedback(self.object, sound_object.s3d, 0, pos, 1, random_float(0.9, 1.1))
    elseif r == 4 then
        self.snd_miau_4:play_no_feedback(self.object, sound_object.s3d, 0, pos, 1, random_float(0.9, 1.1))
    else
        self.snd_miau_5:play_no_feedback(self.object, sound_object.s3d, 0, pos, 1, random_float(0.9, 1.1))
    end
end

function hideout_cat_wrapper:on_interact()
	if self.snd_purr and self.snd_purr:playing() then
		self.snd_purr:stop()
	end

	-- cancel any chain
	self.ai.chain = nil

	self.anim.force_loop = "idle_3"
	self:request_state("idle")
end

--------------------------------------------------------------------------------
-- update
--------------------------------------------------------------------------------
function hideout_cat_wrapper:update(delta)
    bind_hf_base.hf_binder_wrapper.update(self, delta)
	
    ----------------------------------------------------------------------------
    -- texture
    ----------------------------------------------------------------------------
	
	self.new_fur_color = FUR_COLOR
	self.new_fur_hidden = FUR_HIDDEN

    if self.new_fur_color ~= nil and self.new_fur_color ~= self.current_fur_color then
		self.current_fur_color = self.new_fur_color

		local texture = [[items\mtl_hideout_cat_]] .. tostring(self.new_fur_color)

		self.object:set_shader(1, nil, texture)
		if self.new_fur_hidden == true then
			self.object:set_shader(2, nil, [[items\mtl_hideout_cat_full_aplha]])
		else
			self.object:set_shader(2, nil, texture)
		end
	end
	
	if self.new_fur_hidden ~= nil and self.new_fur_hidden ~= self.current_fur_hidden then
		self.current_fur_hidden = self.new_fur_hidden

		local texture = [[items\mtl_hideout_cat_]] .. tostring(self.new_fur_color)

		if self.new_fur_hidden == true then
			self.object:set_shader(2, nil, [[items\mtl_hideout_cat_full_aplha]])
		else
			self.object:set_shader(2, nil, texture)
		end
	end

    local dt  = norm_dt(delta)
    local pos = self.object:position()

	-- track loop elapsed time and fire loop-specific events
	if self.anim.phase == "loop" and self.anim.loop_name then
		self.anim.loop_time = self.anim.loop_time + dt

		-- idle_3 timed miaus
		if self.anim.loop_name == "idle_3" then
			if self.anim.loop_time >= 0.5 and not self.anim.loop_events.miau1 then
				self.anim.loop_events.miau1 = true
				self:_play_random_miau()
			end

			if self.anim.loop_time >= 2.0 and not self.anim.loop_events.miau2 then
				self.anim.loop_events.miau2 = true
				self:_play_random_miau()
			end
		end
	end

    ----------------------------------------------------------------------------
    -- purr
    ----------------------------------------------------------------------------
    local sleeping_now = is_sleep_state(self.anim.state) or is_sleep_state(self.anim.target)

	-- desired volume
	if sleeping_now then
		self.purr.target = PURR_VOLUME_MAX
	else
		self.purr.target = 0.0
	end

	if self.purr.target > 0 and self.snd_purr and not self.snd_purr:playing() then
		self.snd_purr:play_at_pos(self.object, pos, 0, sound_object.s3d + sound_object.looped)
		self.snd_purr.volume = 0.0
		self.purr.volume = 0.0
	end

	-- fade volume
	if self.snd_purr and self.snd_purr:playing() then
		local fade_speed
		if self.purr.target > self.purr.volume then
			fade_speed = PURR_VOLUME_MAX / PURR_FADE_IN
		else
			fade_speed = PURR_VOLUME_MAX / PURR_FADE_OUT
		end

		self.purr.volume = self.purr.volume + fade_speed * dt
		if self.purr.volume > self.purr.target then
			self.purr.volume = self.purr.target
		end
		if self.purr.volume < self.purr.target then
			self.purr.volume = self.purr.target
		end

		self.snd_purr.volume = self.purr.volume

		-- stop sound once fully faded out
		if self.purr.volume <= 0.001 and self.purr.target == 0.0 then
			self.snd_purr:stop()
		end
	end

    ----------------------------------------------------------------------------
    -- lock countdown
    ----------------------------------------------------------------------------
    self.anim.lock = math.max(0.0, self.anim.lock - dt)

    ----------------------------------------------------------------------------
    -- manual loop replay
    ----------------------------------------------------------------------------
    if self.anim.phase == "loop" and self.anim.loop_name and self.anim.lock <= 0 then
		self.anim.loop_timer = self.anim.loop_timer - dt
		if self.anim.loop_timer <= 0 then
			-- reroll a loop variant for the current state
			local new_loop = self:_pick_loop_for_state(self.anim.state)

			-- avoid repeating the same loop 
			if new_loop and new_loop == self.anim.loop_name then
				-- try one more roll
				local retry = self:_pick_loop_for_state(self.anim.state)
				if retry then new_loop = retry end
			end

			-- if state has only one loop (sleep)
			if new_loop then
				self.anim.loop_name = new_loop
				self:_anim_play_cycle(new_loop)
				self:_set_loop(new_loop)
			else
				-- fallback: replay current
				self:_anim_play_cycle(self.anim.loop_name)
				self:_set_loop(self.anim.loop_name)
			end
		end
	end

    ----------------------------------------------------------------------------
    -- state machine tick
    ----------------------------------------------------------------------------
    if self.anim.lock <= 0 then
        -- transition finished
        if self.anim.phase == "trans" and self.anim.target ~= nil then
            self:_enter_state(self.anim.target, true)
        end

        -- end finished
        if self.anim.phase == "end" then
            local p = self.anim.pending
            self.anim.pending = nil
            if p then
                self:_enter_state(p, false)
            else
                self:_enter_state("idle", true)
            end
        end

        -- start finished
		if self.anim.phase == "start" then
			local loop
			if self.anim.force_loop then
				loop = self.anim.force_loop
				self.anim.force_loop = nil
			else
				loop = self:_pick_loop_for_state(self.anim.state)
			end

			if loop then
				self.anim.phase = "loop"
				self:_anim_play_cycle(loop)
				self:_set_loop(loop)
			else
				-- stay idle if no loop found
				self.anim.phase = "loop"
				self:_anim_play_cycle("idle_1")
				self:_set_loop("idle_1")
			end
		end

        -- apply queued request
        if self.anim.pending and self.anim.phase ~= "trans" and self.anim.phase ~= "end" then
            local p = self.anim.pending
            self.anim.pending = nil
            self:request_state(p)
        end
    end

    ----------------------------------------------------------------------------
    -- advance sleep routing chain
    ----------------------------------------------------------------------------
    self:_advance_chain_if_needed()

    ----------------------------------------------------------------------------
    -- autonomous behavior: state duration
    ----------------------------------------------------------------------------
	self.ai.state_timer = self.ai.state_timer - dt
	if self.ai.state_timer <= 0 then
		local next_state, dur = self:_pick_next_state()
		self.ai.state_timer = dur

		-- queue it
		self.ai.next_state = next_state
		self.ai.next_force_loop = (next_state == self.anim.state)
	end

	-- try to apply queued next state
	self:_apply_next_state_if_ready()
end

--------------------------------------------------------------------------------
-- destroy
--------------------------------------------------------------------------------
function hideout_cat_wrapper:net_destroy()
    if self.snd_purr and self.snd_purr:playing() then
        self.snd_purr:stop()
    end
	
	self.snd_pickup:play_no_feedback(self.object, sound_object.s3d, 0, self.object:position(), 1, random_float(0.9, 1.1))
	
    bind_hf_base.hf_binder_wrapper.net_destroy(self)
end