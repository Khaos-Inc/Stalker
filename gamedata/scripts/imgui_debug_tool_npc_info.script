-- NPC Info Debug Tool



function render()
	-- Always display NPC info portions
	local near = xrs_debug_tools.get_debug_npc and xrs_debug_tools.get_debug_npc()
	local near_name = near and near:name() or "No NPC"
	local near_id = near and near:id() or "N/A"
	local has_alife = alife and alife()
	local has_npc = near and near:alive()
	
	ImGui.Text("Debug NPC: " .. near_name .. " (ID: " .. tostring(near_id) .. ")")
	ImGui.Separator()
	
	-- Info Portions Table
	local info_portions = {}
	if has_npc and has_alife then
		local function itr(id, info)
			table.insert(info_portions, info)
		end
		alife():iterate_info(near:id(), itr)
	end
	
	ImGui.Text("NPC Info Portions:")
	if ImGui.BeginTable("NPCInfo", 1, 3, vector2(0, 0), 0) then
		ImGui.TableSetupColumn("Info Portion")
		ImGui.TableHeadersRow()
		
		for i, info in ipairs(info_portions) do
			ImGui.TableNextRow()
			ImGui.TableSetColumnIndex(0)
			ImGui.Text(info)
		end
		
		ImGui.EndTable()
	end
	
	ImGui.Separator()
	
	-- Summary Information
	ImGui.Text("Summary:")
	ImGui.Text("NPC Available: " .. tostring(not not has_npc))
	ImGui.Text("ALife Available: " .. tostring(not not has_alife))
	ImGui.Text("Info Portions Count: " .. tostring(#info_portions))
end

-- Tool registration
imgui_debug_tools.register_tool("npc_info_hud", {
	title = "NPC Info",
	render = render,
	visible = false
})
