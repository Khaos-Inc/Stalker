	{ id = "pu", option = "pu_fov" },
	{ id = "zf4", option = "zf4_fov" },
	{ id = "g43", option = "g43_fov" },
	{ id = "po4", option = "po4_fov" },
	{ id = "monstrum", option = "monstrum_fov" },
	{ id = "acog", option = "acog_fov" },
	{ id = "trihawk", option = "trihawk_fov" },
	{ id = "g36", option = "g36_fov" },
	{ id = "side", option = "side_fov" },
	{ id = "vulcan", option = "vulcan_fov" },
	{ id = "susat", option = "susat_fov" },
	{ id = "bravo", option = "bravo_fov" },
	{ id = "hamr", option = "hamr_fov" },
	{ id = "specter", option = "specter_fov" },
	{ id = "tac30", option = "tac30_fov" },
	{ id = "uh1", option = "uh1_fov" },
	{ id = "e0t2", option = "e0t2_fov" },
	{ id = "devo", option = "devo_fov" },
	{ id = "pn23", option = "pn23_fov" },
	{ id = "razorhd", option = "razorhd_fov" },
	{ id = "ps320", option = "ps320_fov" },
	{ id = "leupold", option = "leupold_fov" },
	{ id = "march", option = "march_fov" },
	{ id = "ado", option = "ado_fov" },
	{ id = "gauss", option = "gauss_fov" },
	{ id = "cortex", option = "cortex_fov" },
	{ id = "marchf", option = "marchf_fov" },
	{ id = "skeet", option = "skeet_fov" },
}
local scope_fov_values = {}
for _, group in ipairs(SCOPE_GROUPS) do
	scope_fov_values[group.id] = DEFAULT_SCOPE_FOV
end

ini_fov = ini_file_ex("items\\weapon_fov_values.ltx")
local mcm_keybinds = ui_mcm and ui_mcm.key_hold

local temp_fov = default_hud_fov
local saved_custom = {}
local saved_gls = {}
local hold_count = 0

function fetch_values()
	use_player_hud_fov = ui_mcm.get("scop/use_player_hud_fov") == true
	use_universal_hud_fov = ui_mcm.get("scop/use_universal_hud_fov") == true
	universal_hud_fov = tonumber(ui_mcm.get("scop/universal_hud_fov")) or universal_hud_fov
	zoom_in_iron 	= ui_mcm.get("scop/iron_fov") or zoom_in_iron
	zoom_in_scope 	= ui_mcm.get("scop/scope_fov") or zoom_in_scope
	gl_fov 			= ui_mcm.get("scop/grenade_fov") or gl_fov
	KEY_INCR 		= ui_mcm.get("scop/keybind_add") or KEY_INCR
	KEY_DECR 		= ui_mcm.get("scop/keybind_subtract") or KEY_DECR
	KEY_RESET 		= ui_mcm.get("scop/keybind_reset") or KEY_RESET
	mode 			= ui_mcm.get("scop/mode") or mode
	modifier 		= ui_mcm.get("scop/modifier") or modifier
	
	for _, group in ipairs(SCOPE_GROUPS) do
		scope_fov_values[group.id] = ui_mcm.get("scop/" .. group.option) or scope_fov_values[group.id]
	end
end

local function get_player_hud_fov()
	default_hud_fov = tonumber(ui_options.get("video/basic/hud_fov")) or tonumber(default_hud_fov) or DEFAULT_SCOPE_FOV
	return default_hud_fov
end

local function actor_on_first_update()
	default_hud_fov = ui_options.get("video/basic/hud_fov") or 0.6
	temp_fov = default_hud_fov
	mcm_keybinds = ui_mcm and ui_mcm.key_hold
	if mcm_keybinds then
		fetch_values()
	end
end

local function on_option_change(mcm)
	default_hud_fov = ui_options.get("video/basic/hud_fov") or 0.6
	if mcm then
		fetch_values()
		if zoomed then
			zoom_in()
		end
	end
end

function execute_hud_fov(fov_value)
	fov_value = tonumber(fov_value) or tonumber(default_hud_fov) or DEFAULT_SCOPE_FOV
	fov_value = math.max(0.1, math.min(1, fov_value))
	exec_console_cmd("hud_fov " .. fov_value)
	temp_fov = fov_value
end

local function resolve_zoom_type(weapon, zoom_type)
	local resolved = tonumber(zoom_type)
	if resolved ~= nil then return resolved end
	local c_weapon = weapon and weapon:cast_Weapon()
	if not c_weapon then return 0 end
	local ok, current = pcall(function() return c_weapon:GetZoomType() end)
	return ok and (tonumber(current) or 0) or 0
end

local function get_aim_context(weapon, scope, two_dim, zoom_type)
	if weapon:weapon_in_grenade_mode() then return "gl" end
	if resolve_zoom_type(weapon, zoom_type) == 1 then return "alt" end
	if scope or two_dim then return "scope" end
	return "iron"
end

local function non_default_fov(value)
	value = tonumber(value)
	if value and math.abs(value - DEFAULT_SCOPE_FOV) > 0.0001 then
		return value
	end
end

local function resolve_universal_override(weapon, scope, two_dim, parent, context)
	if context == "gl" then
		return non_default_fov(saved_gls[parent]) or non_default_fov(gl_fov)
	end

	local iron_fov = ini_fov:r_float_ex(parent, "iron")
	if context == "alt" then
		return non_default_fov(iron_fov) or non_default_fov(zoom_in_iron)
	end

	local custom_fov = non_default_fov(saved_custom[weapon:section()])
	if custom_fov then return custom_fov end

	if ini_fov:section_exist(parent) and scope then
		custom_fov = non_default_fov(ini_fov:r_float_ex(parent, scope))
		if custom_fov then return custom_fov end
	end

	if two_dim and not scope then
		return non_default_fov(zoom_in_scope)
	end

	if scope then
		for _, group in ipairs(SCOPE_GROUPS) do
			if ini_fov:r_bool_ex(group.id, scope) then
				return non_default_fov(scope_fov_values[group.id])
			end
		end
	end

	return non_default_fov(iron_fov) or non_default_fov(zoom_in_iron)
end

function zoom_in(callback_weapon, zoom_type)
	local weapon = callback_weapon or db.actor:active_item()
	if not weapon then
		zoomed = false
		return
	end
	if db.actor:active_detector() then
		zoomed = false
		return
	end
	zoomed = true
	local scope = utils_item.get_attached_scope(weapon)
	local parent = ini_sys:r_string_ex(weapon:section(),"parent_section") or weapon:section()
	local two_dim = ini_sys:r_float_ex(weapon:section(),"scope_status") == 1
	local context = get_aim_context(weapon, scope, two_dim, zoom_type)

	if use_universal_hud_fov then
		execute_hud_fov(resolve_universal_override(weapon, scope, two_dim, parent, context) or universal_hud_fov)
		return
	end
	if use_player_hud_fov then
		execute_hud_fov(get_player_hud_fov())
		return
	end

	local sec_exist = ini_fov:section_exist(parent)
	local iron_fov = ini_fov:r_float_ex(parent, "iron")

	if context == "gl" then
		if saved_gls[parent] then
			execute_hud_fov(saved_gls[parent])
		else
			execute_hud_fov(gl_fov)
		end
		return
	end
	if context == "alt" then
		execute_hud_fov(iron_fov or zoom_in_iron)
		return
	end
	if saved_custom[weapon:section()] then
		execute_hud_fov(saved_custom[weapon:section()])
		return
	end
	
	if sec_exist and scope then
		local custom_fov = ini_fov:r_float_ex(parent, scope)
		if scope and custom_fov then
			execute_hud_fov(custom_fov)
			return
		end
	end
	--set HUD FOV For integrated scopes
	if two_dim and (not scope) then
		execute_hud_fov(zoom_in_scope)
		return
	end
	-- Match the first configured scope group, preserving the original priority.
	if scope then
		for _, group in ipairs(SCOPE_GROUPS) do
			if ini_fov:r_bool_ex(group.id, scope) then
				execute_hud_fov(scope_fov_values[group.id])
				return
			end
		end
		execute_hud_fov(zoom_in_iron)
		return
	end

	execute_hud_fov(zoom_in_iron)
end

function zoom_out()
	execute_hud_fov(use_player_hud_fov and get_player_hud_fov() or default_hud_fov)
	zoomed = false
end

function actor_on_weapon_zoom_type_changed(obj, previous, current)
	local c_weapon = obj and obj:cast_Weapon()
	if not (c_weapon and c_weapon:IsZoomed()) then return end
	zoom_in(obj, current)
end

local function on_key_release(key)
	if key == KEY_INCR or key == KEY_DECR or key == KEY_RESET then
		hold_count = 0
	end
	local weapon = db.actor:active_item()
	if not weapon then return end
	local parent = ini_sys:r_string_ex(weapon:section(),"parent_section") or weapon:section()

	if key == bind_to_dik(key_bindings.kWPN_FUNC) and zoomed then
		if weapon:weapon_in_grenade_mode() then
			if saved_gls[parent] then
				execute_hud_fov(saved_gls[parent])
			else
				execute_hud_fov(gl_fov)
			end
			return
		else zoom_in()
		end
	end
end

function increase_hud_fov()
	if use_universal_hud_fov or use_player_hud_fov then return end
	local weapon = db.actor:active_item()
	local current_fov = tonumber(temp_fov) or tonumber(default_hud_fov) or DEFAULT_SCOPE_FOV
	if (not weapon) or current_fov >= 1 then return end
	local parent = ini_sys:r_string_ex(weapon:section(),"parent_section") or weapon:section()
	local saved_fov = tonumber(saved_custom[weapon:section()]) or current_fov
	local saved_gl_fov = tonumber(saved_gls[parent]) or current_fov
	if weapon:weapon_in_grenade_mode() then
		local next_fov = math.min(1, saved_gl_fov + 0.01)
		execute_hud_fov(next_fov)
		saved_gls[parent] = next_fov
	else
		local next_fov = math.min(1, saved_fov + 0.01)
		execute_hud_fov(next_fov)
		saved_custom[weapon:section()] = next_fov
	end
end

function decrease_hud_fov()
	if use_universal_hud_fov or use_player_hud_fov then return end
	local weapon = db.actor:active_item()
	local current_fov = tonumber(temp_fov) or tonumber(default_hud_fov) or DEFAULT_SCOPE_FOV
	if (not weapon) or current_fov <= 0.1 then return end
	local parent = ini_sys:r_string_ex(weapon:section(),"parent_section") or weapon:section()
	local saved_fov = tonumber(saved_custom[weapon:section()]) or current_fov
	local saved_gl_fov = tonumber(saved_gls[parent]) or current_fov
	if weapon:weapon_in_grenade_mode() then
		local next_fov = math.max(0.1, saved_gl_fov - 0.01)
		execute_hud_fov(next_fov)
		saved_gls[parent] = next_fov
	else
		local next_fov = math.max(0.1, saved_fov - 0.01)
		execute_hud_fov(next_fov)
		saved_custom[weapon:section()] = next_fov
	end
end

function reset_current_weapon()
	if use_universal_hud_fov or use_player_hud_fov then return end
	local weapon = db.actor:active_item()
	if not weapon then return end
	local parent = ini_sys:r_string_ex(weapon:section(),"parent_section") or weapon:section()
	saved_custom[weapon:section()] = nil
	saved_gls[parent] = nil
	if zoomed then
		zoom_in()
	end
end

local function on_key_press(key)
	if zoomed and mcm_keybinds and (mode == 0) and ui_mcm.get_mod_key(modifier) then
		if (key == KEY_INCR) then
			increase_hud_fov()
			return
		end
		if (key == KEY_DECR) then
			decrease_hud_fov()
			return
		end
	end
	if  mcm_keybinds and (mode == 0) and ui_mcm.get_mod_key(modifier) and (key == KEY_RESET) then
		reset_current_weapon()
		return
	end
end

local function on_key_hold(key)
	if key ~= KEY_INCR and key ~= KEY_DECR and key ~= KEY_RESET then return end
	if zoomed and mcm_keybinds and (mode == 1) and ui_mcm.get_mod_key(modifier) then
		if hold_count >= 4 then
			if (key == KEY_INCR) then
				increase_hud_fov()
				hold_count = 0
			end
			if (key == KEY_DECR) then
				decrease_hud_fov()
				hold_count = 0
			end
			if (key == KEY_RESET) then
				reset_current_weapon()
				hold_count = 0
			end
		end
		hold_count = hold_count + 1
	end
end

local function save_state(mdata)
	mdata.snk_saved_hud_fov = saved_custom
	mdata.snk_saved_gl_fov = saved_gls
end

local function load_state(mdata)
	saved_custom = mdata.snk_saved_hud_fov or {}
	saved_gls = mdata.snk_saved_gl_fov or {}
end

