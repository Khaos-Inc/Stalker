--keybinds
local KEY_INCR = DIK_keys.DIK_ADD
local KEY_DECR = DIK_keys.DIK_SUBTRACT
local KEY_RESET = DIK_keys.DIK_BACK
local mode 		= 1
local modifier 	= 1

--default values
local zoom_in_iron 		= ui_options.get("video/basic/hud_fov")
local zoom_in_scope 	= ui_options.get("video/basic/hud_fov")
local gl_fov 			= ui_options.get("video/basic/hud_fov")
local default_hud_fov 	= ui_options.get("video/basic/hud_fov")
local zoomed 			= false
local use_player_hud_fov = false
local use_universal_hud_fov = false
local universal_hud_fov = 0.6

local DEFAULT_SCOPE_FOV = 0.6
local SCOPE_GROUPS = {
	{ id = "1p78", option = "1p78_fov" },
	{ id = "1pn93hv", option = "1pn93hv_fov" },
	{ id = "1p29", option = "1p29_fov" },
	{ id = "ps01", option = "ps01_fov" },
