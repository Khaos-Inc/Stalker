-- Position Other Debug Tool



function render()
	local obj = xrs_debug_tools.get_debug_npc()
	local obj_name = obj and obj:alive() and obj:name() or "No NPC"
	local obj_id = obj and obj:alive() and obj:id() or "N/A"
	
	ImGui.Text("Target NPC: " .. obj_name .. " (ID: " .. tostring(obj_id) .. ")")
	ImGui.Separator()
	
	-- Always display position information, even if no valid NPC
	local se_obj, lvid, gvid, pos, dir, angle, pos2, valid, dist, visual
	
	if (obj and obj:alive()) then
		se_obj = alife_object(obj:id())
		if (se_obj) then
			lvid, gvid = obj:level_vertex_id(), obj:game_vertex_id()
			pos = obj:position()
			dir = obj:direction()
			angle = se_obj.angle
			pos2 = level.vertex_position(lvid)
			valid = pos2:distance_to(pos) <= 0.7
			dist = level.get_target_dist and level.get_target_dist()
			visual = obj:get_visual_name()
		end
	end
	
	-- Position Information
	ImGui.Text("Position Information:")
	ImGui.Text("Name: " .. obj_name)
	ImGui.Text("Visual: " .. tostring(visual or "N/A"))
	local dist_str = dist and string.format("%.3f", dist) or "N/A"
	ImGui.Text("Distance: " .. dist_str)
	ImGui.Text("Level Vertex ID: " .. tostring(lvid or "N/A"))
	ImGui.Text("Game Vertex ID: " .. tostring(gvid or "N/A"))
	local pos_str = pos and string.format("%.3f, %.3f, %.3f", pos.x, pos.y, pos.z) or "N/A"
	ImGui.Text("Position: " .. pos_str)
	local dir_str = dir and string.format("%.3f, %.3f, %.3f HP (%.3f, %.3f)", dir.x, dir.y, dir.z, dir:getH(), dir:getP()) or "N/A"
	ImGui.Text("Direction: " .. dir_str)
	local angle_str = angle and string.format("%.3f, %.3f, %.3f", angle.x, angle.y, angle.z) or "N/A"
	ImGui.Text("Angle: " .. angle_str)
	ImGui.Text("Position Valid: " .. tostring(valid or false))
end

-- Tool registration
imgui_debug_tools.register_tool("position_other_hud", {
	title = "Position Other",
	render = render,
	visible = false
})
