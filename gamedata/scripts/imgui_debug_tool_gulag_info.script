-- Gulag Info Debug Tool



function render()
	-- Always display gulag information
	local has_smart_terrain = smart_terrain and smart_terrain.nearest_to_actor_smart
	local smart_id = has_smart_terrain and smart_terrain.nearest_to_actor_smart.id
	local smart = smart_id and alife_object and alife_object(smart_id)
	local has_jobs = smart and smart.stalker_jobs
	
	ImGui.Text("Gulag Information:")
	ImGui.Separator()
	
	-- Smart Terrain Information
	ImGui.Text("Smart Terrain Information:")
	if smart then
		ImGui.Text("Smart Name: " .. (smart:name() or "Unknown"))
		ImGui.Text("Distance: " .. tostring(smart_terrain.nearest_to_actor_smart.dist or "N/A"))
		ImGui.Text("Is Faction Controlled: " .. tostring(smart.faction_controlled or false))
		ImGui.Text("Faction: " .. (smart.faction or "None"))
		ImGui.Text("Job Count: " .. (has_jobs and tostring(#smart.stalker_jobs) or "0"))
	else
		ImGui.Text("Status: No nearest smart terrain")
	end
	
	ImGui.Separator()
	
	-- Jobs Table
	local job_data = {}
	if has_jobs then
		for i = 1, #smart.stalker_jobs do
			local job = smart.stalker_jobs[i]
			local sec = job.section and string.gsub(job.section, "logic@", "") or "Unknown"
			local npc_name = smart.npc_by_job_section and smart.npc_by_job_section[job.section] or "empty"
			table.insert(job_data, {
				index = tostring(i),
				section = sec,
				npc = npc_name
			})
		end
	end
	
	ImGui.Text("Stalker Jobs:")
	if ImGui.BeginTable("StalkerJobs", 3, 3, vector2(0, 0), 0) then
		ImGui.TableSetupColumn("Job #")
		ImGui.TableSetupColumn("Section")
		ImGui.TableSetupColumn("NPC")
		ImGui.TableHeadersRow()
		
		for _, job in ipairs(job_data) do
			ImGui.TableNextRow()
			ImGui.TableSetColumnIndex(0)
			ImGui.Text(job.index)
			ImGui.TableSetColumnIndex(1)
			ImGui.Text(job.section)
			ImGui.TableSetColumnIndex(2)
			ImGui.Text(job.npc)
		end
		
		ImGui.EndTable()
	end
	
	ImGui.Separator()
	
	-- Summary Information
	ImGui.Text("Summary:")
	ImGui.Text("Smart Terrain Available: " .. tostring(smart ~= nil))
	ImGui.Text("Jobs Available: " .. tostring(not not has_jobs))
	ImGui.Text("Total Jobs: " .. tostring(#job_data))
end

-- Tool registration
imgui_debug_tools.register_tool("gulag_info_hud", {
	title = "Gulag Info",
	render = render,
	visible = false
})
