-- Register this tool
imgui_debug_tools.register_tool("SpaceRestrictorHud", {
    title = "Space Restrictors",
    render = function()
        render_space_restrictor_hud()
    end,
    visible = false
})

function render_space_restrictor_hud()
    -- Collect all space restrictors first
    local restrictors = {}
    for k, v in pairs(db.storage) do
        if v.object and tostring(v.active_section) ~= "nil" then
            table.insert(restrictors, {
                name = v.object:name(),
                id = v.object:id(),
                section = v.active_section
            })
        end
    end
    
    -- Display count
    ImGui.Text("Active Space Restrictors: " .. tostring(#restrictors))
    ImGui.Separator()
    
    if #restrictors == 0 then
        ImGui.Text("No active space restrictors found")
        return
    end
    
    -- Display in table format
    local table_flags = 3 -- Borders(1) + RowBg(2)
    if ImGui.BeginTable("SpaceRestrictorsTable", 3, table_flags, vector2(0, 0), 0) then
        ImGui.TableSetupColumn("Name", 2, 0, 0) -- 2 = WidthFixed
        ImGui.TableSetupColumn("ID", 2, 0, 0)
        ImGui.TableSetupColumn("Section", 2, 0, 0)
        ImGui.TableHeadersRow()
        
        for _, restrictor in ipairs(restrictors) do
            ImGui.TableNextRow()
            
            ImGui.TableNextColumn()
            ImGui.Text(restrictor.name)
            
            ImGui.TableNextColumn()
            ImGui.Text(tostring(restrictor.id))
            
            ImGui.TableNextColumn()
            ImGui.Text(restrictor.section)
        end
        
        ImGui.EndTable()
    end
end