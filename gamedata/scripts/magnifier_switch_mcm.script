-- Compatibility settings provider. The UI is registered by z_3d_scopes_mcm.
defaults = {
	["use_mousewheel"] = true,
	["mwheel_switch_ads_only"] = true,
	["switch_bind"] = bind_to_dik(key_bindings.kWPN_FUNC),
	["modifier"] = 0,
	["press_type"] = 1,
	["keep_aim_toggle"] = true,
	["switch_sound"] = true,
	["debug"] = false,
}

function get_config(key)
	if not ui_mcm then
		return defaults[key]
	end

	local value = ui_mcm.get("3d_scopes/magnifier_switch/" .. key)
	if value == nil then
		value = ui_mcm.get("magnifier_switch/" .. key)
	end
	if value == nil then
		value = defaults[key]
	end
	return value
end
