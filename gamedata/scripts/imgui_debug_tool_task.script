-- Register this tool
imgui_debug_tools.register_tool("TaskHud", {
    title = "Task HUD",
    render = function()
        render_task_hud()
    end,
    visible = false
})

function render_task_hud()
    local debug_task_infos = task_manager.get_task_manager().task_info
    
    if not debug_task_infos or next(debug_task_infos) == nil then
        ImGui.Text("No active tasks found")
        return
    end
    
    local table_flags = 3 -- Borders(1) + RowBg(2)
    if not ImGui.BeginTable("TaskTable", 7, table_flags, vector2(0, 0), 0) then
        return
    end
    
    ImGui.TableSetupColumn("Task", 2, 0, 0)
    ImGui.TableSetupColumn("Giver", 2, 0, 0)
    ImGui.TableSetupColumn("Status", 2, 0, 0)
    ImGui.TableSetupColumn("Stage", 2, 0, 0)
    ImGui.TableSetupColumn("Smart", 2, 0, 0)
    ImGui.TableSetupColumn("Target", 2, 0, 0)
    ImGui.TableSetupColumn("Cooldown", 2, 0, 0)
    ImGui.TableHeadersRow()
    
    for k, v in pairs(debug_task_infos) do
        ImGui.TableNextRow()
        
        -- Task name
        ImGui.TableNextColumn()
        ImGui.Text(k)
        
        -- Giver
        ImGui.TableNextColumn()
        local giver_text = ""
        if v.task_giver_id then
            local se_obj = alife_object(v.task_giver_id)
            giver_text = se_obj and se_obj:name() or "Unknown"
        end
        ImGui.Text(giver_text)
        
        -- Status
        ImGui.TableNextColumn()
        local status_text = v.status == "selected" and "selected" or tostring(v.status or "")
        ImGui.Text(status_text)
        
        -- Stage
        ImGui.TableNextColumn()
        local stage_text = (v.stage and v.stage > 0) and tostring(v.stage) or "0"
        ImGui.Text(stage_text)
        
        -- Smart
        ImGui.TableNextColumn()
        local smart_id = load_var(db.actor, k .. "_id")
        local smart = smart_id and alife_object(smart_id)
        local smart_text = smart and smart:name() or ""
        ImGui.Text(smart_text)
        
        -- Target
        ImGui.TableNextColumn()
        local target_id = load_var(db.actor, k .. "_target_id")
        local target_obj = target_id and alife_object(target_id)
        local target_text = target_obj and target_obj:name() or ""
        ImGui.Text(target_text)
        
        -- Cooldown
        ImGui.TableNextColumn()
        local cooldown_text = ""
        if v.repeat_timeout and v.timeout then
            local cooldown = v.repeat_timeout - game.get_game_time():diffSec(v.timeout)
            cooldown_text = tostring(math.floor(cooldown))
        end
        ImGui.Text(cooldown_text)
    end
    
    ImGui.EndTable()
end